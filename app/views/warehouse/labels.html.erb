<div class="w-full">
  <div class="mb-6 flex items-center justify-between gap-3 print:hidden">
    <h1 class="text-2xl font-bold text-slate-900"><%= t(".title") %></h1>
    <button type="button" onclick="window.print()" class="flex min-h-12 cursor-pointer items-center gap-2 rounded-full bg-sky-800 px-5 font-medium text-white transition-all duration-200 ease-out hover:bg-sky-900 active:scale-95">
      <%= material_icon "print" %> <%= t(".print") %>
    </button>
  </div>
  <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
    <% @slots.each do |slot| %>
      <li class="break-inside-avoid rounded-2xl border border-slate-200 bg-white p-4 text-center">
        <div class="mx-auto w-32"><%= warehouse_slot_qr_svg(slot).html_safe %></div>
        <p class="mt-2 text-lg font-bold text-slate-900"><%= slot.code %></p>
      </li>
    <% end %>
  </ul>
</div>
