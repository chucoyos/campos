<div class="w-full max-w-md rounded-3xl border border-slate-100 bg-white p-8 text-center shadow-sm">
  <span class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl <%= @status >= 500 ? "bg-red-50 text-red-600" : "bg-amber-50 text-amber-600" %>">
    <%= material_icon(@status >= 500 ? "error" : "anchor", classes: "!text-4xl") %>
  </span>
  <p class="text-5xl font-bold text-slate-300"><%= @code %></p>
  <h1 class="mt-2 text-2xl font-bold text-slate-900"><%= t("errors.#{@code}.title") %></h1>
  <p class="mt-2 text-slate-500"><%= t("errors.#{@code}.message") %></p>

  <%= link_to "/", class: "mt-6 inline-flex min-h-12 items-center justify-center gap-2 rounded-2xl bg-indigo-600 px-5 font-medium text-white transition-all duration-200 ease-out hover:bg-indigo-700 active:scale-95" do %>
    <%= material_icon "home" %> <%= t("errors.back_home") %>
  <% end %>
</div>
