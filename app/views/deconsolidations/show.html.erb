<% container = @deconsolidation.container %>
<% stages = Deconsolidation::STAGE_PHOTO_SECTIONS.to_a %>
<% current = @deconsolidation.vaciado? ? stages.size : stages.index { |status, _| status == @deconsolidation.status } %>
<div class="mx-auto w-full max-w-4xl space-y-6">
  <section class="rounded-3xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
    <%= link_to deconsolidations_path, class: "mb-3 inline-flex min-h-12 items-center gap-1 text-sm font-medium text-indigo-700" do %>
      <%= material_icon "arrow_back" %> <%= t(".back") %>
    <% end %>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h1 class="text-2xl font-bold text-slate-900"><%= container.number %></h1>
        <p class="text-sm text-slate-600"><%= container.master_bl&.number %> · <%= container.current_yard_slot&.code || t(".no_slot") %></p>
      </div>
      <%= render "deconsolidations/status", deconsolidation: @deconsolidation %>
    </div>

    <ol class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
      <% stages.each_with_index do |(status, section), index| %>
        <% done = index < current || @deconsolidation.vaciado? %>
        <li class="rounded-2xl p-4 <%= index == current && !@deconsolidation.vaciado? ? 'bg-sky-50 ring-2 ring-sky-600' : (done ? 'bg-emerald-50' : 'bg-slate-50') %>">
          <p class="flex items-center gap-2 font-semibold text-slate-900"><%= material_icon(done ? "check_circle" : "radio_button_unchecked") %> <%= t("deconsolidations.stages.#{status}") %></p>
          <p class="mt-1 text-sm text-slate-600"><%= t(".photos_count", count: @deconsolidation.photo_count(section)) %></p>
        </li>
      <% end %>
    </ol>

    <% unless @deconsolidation.vaciado? %>
      <% next_stage = { "apertura" => "start", "desconsolidando" => "empty", "vacio" => "finish" }[@deconsolidation.status] %>
      <%= button_to advance_deconsolidation_path(@deconsolidation), method: :patch,
            form: { data: { turbo_confirm: t(".confirm_#{next_stage}"), turbo_confirm_tone: "success" } },
            class: "mt-6 flex min-h-12 w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-emerald-600 px-6 font-medium text-white transition-all duration-200 ease-out hover:bg-emerald-700 active:scale-95 sm:w-auto" do %>
        <%= material_icon "task_alt" %> <%= t(".advance_#{next_stage}") %>
      <% end %>
    <% end %>
  </section>

  <section class="rounded-3xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
    <h2 class="mb-1 flex items-center gap-2 text-lg font-bold text-slate-900"><%= material_icon "inventory_2" %> <%= t(".cargo_title") %></h2>
    <p class="mb-4 text-sm text-slate-600"><%= t(".cargo_progress", stored: @deconsolidation.stored_count, total: @deconsolidation.total_count) %></p>
    <%= link_to labels_deconsolidation_path(@deconsolidation), class: "mb-4 inline-flex min-h-12 items-center gap-2 rounded-full bg-indigo-50 px-5 font-medium text-indigo-700 transition-all duration-200 ease-out hover:bg-indigo-100 active:scale-95" do %>
      <%= material_icon "qr_code_2" %> <%= t(".labels") %>
    <% end %>
    <% if @pending_items.empty? %>
      <p class="rounded-2xl bg-emerald-50 p-4 text-sm text-emerald-800"><%= t(".cargo_done") %></p>
    <% else %>
      <ul class="space-y-2">
        <% @pending_items.each do |item| %>
          <li class="rounded-2xl bg-slate-50 p-3 text-sm"><span class="font-medium text-slate-900"><%= item.description %></span> · <%= item.cargo_packaging.name %></li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section class="rounded-3xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
    <h2 class="mb-4 flex items-center gap-2 text-lg font-bold text-slate-900"><%= material_icon "photo_camera" %> <%= t(".photos_title") %></h2>
    <div class="space-y-3">
      <% Container::PHOTO_SECTIONS.each do |section| %>
        <%= render "containers/photo_section", container: container, section: section, count: @deconsolidation.photo_count(section), return_to: deconsolidation_path(@deconsolidation) %>
      <% end %>
    </div>
  </section>
</div>
