<div class="mx-auto w-full max-w-2xl">
  <%= link_to carriers_path, class: "mb-4 inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-800" do %>
    <%= material_icon "arrow_back" %> <%= t("shared.actions.back") %>
  <% end %>

  <div class="rounded-3xl border border-slate-100 bg-white p-8 shadow-sm">
    <div class="mb-6 flex items-center gap-4">
      <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600">
        <%= material_icon "local_shipping", classes: "!text-3xl" %>
      </span>
      <h1 class="text-2xl font-bold text-slate-900"><%= @carrier.name %></h1>
    </div>

    <dl class="grid gap-4 rounded-2xl bg-slate-50 p-4 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-slate-500"><%= Carrier.human_attribute_name(:created_at) %></dt>
        <dd class="font-medium text-slate-800"><%= l(@carrier.created_at, format: :long) %></dd>
      </div>
      <div>
        <dt class="text-slate-500"><%= Carrier.human_attribute_name(:updated_at) %></dt>
        <dd class="font-medium text-slate-800"><%= l(@carrier.updated_at, format: :long) %></dd>
      </div>
    </dl>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <%= link_to edit_carrier_path(@carrier), class: "flex min-h-12 items-center gap-2 rounded-2xl bg-indigo-600 px-5 font-medium text-white transition-colors hover:bg-indigo-700" do %>
        <%= material_icon "edit" %> <%= t("shared.actions.edit") %>
      <% end %>
      <%= button_to carrier_path(@carrier), method: :delete,
            form: { data: { turbo_confirm: t("shared.actions.confirm_destroy", name: @carrier.name) } },
            class: "flex min-h-12 cursor-pointer items-center gap-2 rounded-2xl px-5 font-medium text-red-600 transition-colors hover:bg-red-50" do %>
        <%= material_icon "delete" %> <%= t("shared.actions.destroy") %>
      <% end %>
    </div>
  </div>
</div>
