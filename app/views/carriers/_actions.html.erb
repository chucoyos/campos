<%= link_to carrier_path(carrier), title: t("shared.actions.show"), aria: { label: t("shared.actions.show_named", name: carrier.name) },
      class: "flex h-12 w-12 items-center justify-center rounded-2xl text-slate-600 transition-colors hover:bg-sky-50 hover:text-sky-600" do %>
  <%= material_icon "visibility" %>
<% end %>
<%= link_to edit_carrier_path(carrier), title: t("shared.actions.edit"), aria: { label: t("shared.actions.edit_named", name: carrier.name) },
      class: "flex h-12 w-12 items-center justify-center rounded-2xl text-slate-600 transition-colors hover:bg-indigo-50 hover:text-indigo-600" do %>
  <%= material_icon "edit" %>
<% end %>
<%= button_to carrier_path(carrier), method: :delete, title: t("shared.actions.destroy"), aria: { label: t("shared.actions.destroy_named", name: carrier.name) },
      form: { data: { turbo_confirm: t("shared.actions.confirm_destroy", name: carrier.name) } },
      class: "flex h-12 w-12 cursor-pointer items-center justify-center rounded-2xl text-slate-600 transition-colors hover:bg-red-50 hover:text-red-600" do %>
  <%= material_icon "delete" %>
<% end %>
