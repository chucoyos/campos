<%= render "shared/row_actions", label: t("shared.actions.title_named", name: carrier.name), items: [
  { label: t("shared.actions.show"), icon: "visibility", href: carrier_path(carrier) },
  { label: t("shared.actions.edit"), icon: "edit", href: edit_carrier_path(carrier) },
  { label: t("shared.actions.destroy"), icon: "delete", href: carrier_path(carrier), method: :delete,
    confirm: t("shared.actions.confirm_destroy", name: carrier.name), tone: :danger }
] %>
