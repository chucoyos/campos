<div class="mx-auto w-full max-w-6xl">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900"><%= t(".title") %></h1>
      <p class="text-sm text-slate-500"><%= t(".subtitle") %></p>
    </div>
    <%= link_to new_cargo_manifest_path, class: "flex min-h-12 items-center gap-2 rounded-full bg-indigo-600 px-5 font-medium text-white transition-all duration-200 ease-out hover:bg-indigo-700 active:scale-95" do %>
      <%= material_icon "add" %> <%= t(".new") %>
    <% end %>
  </div>

  <% if @cargo_manifests.empty? %>
    <p class="rounded-2xl bg-white p-6 text-sm text-slate-500 shadow-sm"><%= t(".empty") %></p>
  <% else %>
    <div class="space-y-3">
      <% @cargo_manifests.each do |manifest| %>
        <%= link_to cargo_manifest_path(manifest), class: "flex min-h-16 flex-col justify-between gap-2 rounded-2xl border border-slate-100 bg-white p-4 shadow-sm transition-all duration-200 ease-out hover:bg-slate-50 sm:flex-row sm:items-center" do %>
          <span class="flex items-center gap-2 font-medium text-slate-900"><span class="text-sky-800"><%= manifest_icon(manifest) %></span> <%= manifest.container&.number || t(".general_cargo") %></span>
          <span class="text-sm text-slate-600"><%= manifest.client.name %></span>
          <span class="text-sm text-slate-500"><%= t("cargo_manifests.statuses.#{manifest.status}") %></span>
          <span class="text-sm text-indigo-600"><%= t(".item_count", count: manifest.items_count) %></span>
        <% end %>
      <% end %>
    </div>
    <%= render "shared/pagination", pagy: @pagy %>
  <% end %>
</div>
