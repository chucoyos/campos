<div class="mx-auto mt-16 w-full max-w-md">
  <div class="rounded-3xl border border-slate-100 bg-white p-8 shadow-sm">
    <h1 class="mb-6 text-2xl font-bold text-slate-900"><%= t(".title") %></h1>
    <%= render "devise/shared/error_messages", resource: resource if resource.errors.any? %>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
      <%= f.hidden_field :reset_password_token %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", placeholder: t(".new_password"),
            class: "w-full rounded-2xl border border-slate-200 p-3 focus:border-indigo-500 focus:outline-none" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: User.human_attribute_name(:password_confirmation),
            class: "w-full rounded-2xl border border-slate-200 p-3 focus:border-indigo-500 focus:outline-none" %>
      <%= f.button t(".submit"), class: "w-full cursor-pointer rounded-2xl bg-indigo-600 p-3 font-medium text-white hover:bg-indigo-700" %>
    <% end %>
  </div>
</div>
