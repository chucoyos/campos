<div class="mx-auto mt-16 w-full max-w-md">
  <div class="rounded-3xl border border-slate-100 bg-white p-8 shadow-sm">
    <h1 class="mb-2 text-2xl font-bold text-slate-900"><%= t(".title") %></h1>
    <p class="mb-6 text-sm text-slate-500"><%= t(".subtitle") %></p>
    <%= render "devise/shared/error_messages", resource: resource if resource.errors.any? %>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, placeholder: User.human_attribute_name(:email),
            class: "w-full rounded-2xl border border-slate-200 p-3 focus:border-indigo-500 focus:outline-none" %>
      <%= f.button t(".submit"), class: "w-full cursor-pointer rounded-2xl bg-indigo-600 p-3 font-medium text-white hover:bg-indigo-700" %>
    <% end %>
    <%= link_to t(".back_to_login"), new_session_path(resource_name), class: "mt-4 block text-center text-sm text-indigo-600" %>
  </div>
</div>
