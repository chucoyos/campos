<div class="mx-auto mt-16 w-full max-w-md">
  <div class="rounded-3xl border border-slate-100 bg-white p-8 shadow-sm">
    <div class="mb-6 flex flex-col items-center gap-2">
      <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600">
        <%= material_icon "local_shipping", classes: "!text-3xl" %>
      </span>
      <h1 class="text-2xl font-bold text-slate-900">Soluciones Campos</h1>
      <p class="text-sm text-slate-500">Inicia sesión para continuar</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
      <div>
        <%= f.label :email, "Correo electrónico", class: "mb-1 block text-sm font-medium" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
              class: "w-full rounded-2xl border border-slate-200 p-3 focus:border-indigo-500 focus:outline-none" %>
      </div>
      <div>
        <%= f.label :password, "Contraseña", class: "mb-1 block text-sm font-medium" %>
        <%= f.password_field :password, autocomplete: "current-password", required: true,
              class: "w-full rounded-2xl border border-slate-200 p-3 focus:border-indigo-500 focus:outline-none" %>
      </div>
      <% if devise_mapping.rememberable? %>
        <label class="flex items-center gap-2 text-sm text-slate-600">
          <%= f.check_box :remember_me %> Recordarme
        </label>
      <% end %>
      <%= f.button class: "flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl bg-indigo-600 p-3 font-medium text-white hover:bg-indigo-700" do %>
        <%= material_icon "login" %> Iniciar sesión
      <% end %>
    <% end %>

    <%= link_to "¿Olvidaste tu contraseña?", new_password_path(resource_name), class: "mt-4 block text-center text-sm text-indigo-600" %>
  </div>
</div>
