<div class="grid min-h-screen lg:grid-cols-2">
  <section class="relative hidden overflow-hidden bg-[#000052] lg:flex lg:flex-col lg:justify-between"
           aria-label="<%= t(".hero.label") %>">
    <%= image_tag "login.jpeg", alt: "", class: "absolute inset-x-0 top-0 h-[62%] w-full object-cover object-top" %>
    <div class="absolute inset-0 bg-gradient-to-t from-[#000052] from-45% via-[#000052]/40 via-70% to-[#000052]/10"></div>

    <div class="relative flex items-center gap-3 p-10 text-white">
      <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/10 backdrop-blur-sm">
        <%= material_icon "anchor" %>
      </span>
      <p class="text-sm font-semibold uppercase tracking-[0.3em]"><%= t(".hero.brand") %></p>
    </div>

    <div class="relative p-10 pb-14 text-white xl:p-16 xl:pb-20">
      <h2 class="max-w-xl text-4xl font-bold leading-tight xl:text-5xl">
        <%= t(".hero.headline_html", accent: tag.span(t(".hero.accent"), class: "text-red-500")) %>
      </h2>
      <p class="mt-5 max-w-lg text-lg text-slate-200"><%= t(".hero.description") %></p>

      <ul class="mt-8 grid max-w-xl gap-3 sm:grid-cols-3">
        <% %w[deconsolidation yard gate].each do |feature| %>
          <li class="flex flex-col gap-2 rounded-2xl border border-white/15 bg-white/10 p-4 backdrop-blur-md">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-white/15 text-white">
              <%= material_icon t(".hero.features.#{feature}.icon") %>
            </span>
            <span class="text-sm font-semibold"><%= t(".hero.features.#{feature}.title") %></span>
            <span class="text-xs text-slate-300"><%= t(".hero.features.#{feature}.text") %></span>
          </li>
        <% end %>
      </ul>
    </div>
  </section>

  <section class="relative flex items-center justify-center bg-gradient-to-b from-slate-50 to-white px-5 py-10 sm:px-10">
    <div class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-[#000052] via-[#000052] to-red-600 lg:hidden"></div>

    <div class="w-full max-w-md">
      <div class="mb-8 flex flex-col items-center gap-3 text-center">
        <%= image_tag "logo_full.svg", alt: "Soluciones Estratégicas Portuarias Campos", class: "h-28 w-auto sm:h-32" %>
      </div>

      <div class="rounded-3xl border border-slate-200/70 bg-white p-6 shadow-md sm:p-8">
        <h1 class="text-2xl font-bold text-[#000052]"><%= t(".title") %></h1>
        <p class="mt-1 mb-6 text-sm text-slate-500"><%= t(".subtitle") %></p>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
          <div>
            <%= f.label :email, class: "mb-1.5 block text-sm font-medium text-slate-700" %>
            <div class="relative">
              <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400"><%= material_icon "mail" %></span>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
                    class: "min-h-12 w-full rounded-2xl border border-slate-200 bg-slate-50 py-3 pl-11 pr-3 transition-all duration-200 ease-out focus:border-[#000052] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#000052]/20" %>
            </div>
          </div>
          <div>
            <%= f.label :password, class: "mb-1.5 block text-sm font-medium text-slate-700" %>
            <div class="relative">
              <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400"><%= material_icon "lock" %></span>
              <%= f.password_field :password, autocomplete: "current-password", required: true,
                    class: "min-h-12 w-full rounded-2xl border border-slate-200 bg-slate-50 py-3 pl-11 pr-3 transition-all duration-200 ease-out focus:border-[#000052] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#000052]/20" %>
            </div>
          </div>
          <div class="flex flex-wrap items-center justify-between gap-2">
            <% if devise_mapping.rememberable? %>
              <label class="flex min-h-10 items-center gap-2 text-sm text-slate-600">
                <%= f.check_box :remember_me, class: "h-4 w-4 rounded accent-[#000052]" %> <%= User.human_attribute_name(:remember_me) %>
              </label>
            <% end %>
            <%= link_to t(".forgot_password"), new_password_path(resource_name), class: "text-sm font-medium text-[#000052] hover:text-red-600" %>
          </div>
          <%= f.button class: "flex min-h-12 w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-[#000052] p-3 font-medium text-white shadow-sm transition-all duration-200 ease-out hover:bg-[#0a1a7a] hover:shadow-md active:scale-95" do %>
            <%= material_icon "login" %> <%= t(".submit") %>
          <% end %>
        <% end %>
      </div>

      <p class="mt-6 text-center text-xs text-slate-400">&copy; <%= Date.current.year %> Soluciones Campos</p>
    </div>
  </section>
</div>
