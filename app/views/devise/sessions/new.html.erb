<div class="relative isolate min-h-screen overflow-hidden bg-[#000052]">
  <%= image_tag "login.jpeg", alt: "", class: "absolute inset-0 -z-20 h-full w-full object-cover" %>
  <div class="absolute inset-0 -z-10 bg-gradient-to-br from-[#000052]/85 via-[#000052]/55 to-[#000052]/80"></div>
  <div class="pointer-events-none absolute -left-24 top-1/3 -z-10 h-80 w-80 rounded-full bg-red-600/25 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-24 right-1/4 -z-10 h-96 w-96 rounded-full bg-sky-400/25 blur-3xl"></div>

  <div class="grid min-h-screen lg:grid-cols-[1.15fr_1fr]">
    <section class="hidden flex-col justify-between p-10 text-white lg:flex xl:p-16" aria-label="<%= t(".hero.label") %>">
      <div class="flex w-fit items-center gap-3 rounded-full border border-white/25 bg-white/10 py-2 pl-2 pr-5 shadow-lg shadow-black/10 backdrop-blur-xl">
        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-white/20">
          <%= material_icon "anchor" %>
        </span>
        <p class="text-xs font-semibold uppercase tracking-[0.3em]"><%= t(".hero.brand") %></p>
      </div>

      <div>
        <h2 class="max-w-xl text-4xl font-bold leading-tight drop-shadow-sm xl:text-5xl">
          <%= t(".hero.headline_html", accent: tag.span(t(".hero.accent"), class: "text-red-400")) %>
        </h2>
        <p class="mt-5 max-w-lg text-lg text-sky-50/90"><%= t(".hero.description") %></p>

        <ul class="mt-10 grid max-w-2xl gap-4 sm:grid-cols-3">
          <% %w[deconsolidation yard gate].each do |feature| %>
            <li class="group flex flex-col gap-3 rounded-3xl border border-white/25 bg-white/10 p-5 shadow-lg shadow-black/10 ring-1 ring-inset ring-white/10 backdrop-blur-xl transition-all duration-200 ease-out hover:-translate-y-1 hover:bg-white/20 hover:shadow-xl">
              <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-white/40 to-white/10 text-white shadow-inner">
                <%= material_icon t(".hero.features.#{feature}.icon") %>
              </span>
              <span class="text-sm font-semibold"><%= t(".hero.features.#{feature}.title") %></span>
              <span class="text-xs leading-relaxed text-sky-50/80"><%= t(".hero.features.#{feature}.text") %></span>
            </li>
          <% end %>
        </ul>
      </div>

      <p class="text-xs text-sky-100/70">&copy; <%= Date.current.year %> Soluciones Campos</p>
    </section>

    <section class="flex items-center justify-center px-5 py-10 sm:px-10">
      <div class="w-full max-w-md">
        <div class="mb-6 flex justify-center">
          <div class="rounded-3xl border border-white/70 bg-white/90 px-6 py-4 shadow-lg shadow-black/10 backdrop-blur-xl">
            <%= image_tag "logo_full.svg", alt: "Soluciones Estratégicas Portuarias Campos", class: "h-20 w-auto sm:h-24" %>
          </div>
        </div>

        <div class="rounded-3xl border border-white/60 bg-white/75 p-6 shadow-2xl shadow-black/20 ring-1 ring-inset ring-white/40 backdrop-blur-2xl sm:p-8">
          <h1 class="text-2xl font-bold text-[#000052]"><%= t(".title") %></h1>
          <p class="mt-1 mb-6 text-sm text-slate-600"><%= t(".subtitle") %></p>

          <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
            <div>
              <%= f.label :email, class: "mb-1.5 block text-sm font-medium text-slate-700" %>
              <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400"><%= material_icon "mail" %></span>
                <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
                      class: "min-h-12 w-full rounded-2xl border border-slate-200/80 bg-white/70 py-3 pl-11 pr-3 transition-all duration-200 ease-out focus:border-[#000052] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#000052]/20" %>
              </div>
            </div>
            <div>
              <%= f.label :password, class: "mb-1.5 block text-sm font-medium text-slate-700" %>
              <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400"><%= material_icon "lock" %></span>
                <%= f.password_field :password, autocomplete: "current-password", required: true,
                      class: "min-h-12 w-full rounded-2xl border border-slate-200/80 bg-white/70 py-3 pl-11 pr-3 transition-all duration-200 ease-out focus:border-[#000052] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#000052]/20" %>
              </div>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <% if devise_mapping.rememberable? %>
                <label class="flex min-h-10 items-center gap-2 text-sm text-slate-600">
                  <%= f.check_box :remember_me, class: "h-4 w-4 rounded accent-[#000052]" %> <%= User.human_attribute_name(:remember_me) %>
                </label>
              <% end %>
              <%= link_to t(".forgot_password"), new_password_path(resource_name), class: "text-sm font-medium text-[#000052] hover:text-red-600" %>
            </div>
            <%= f.button class: "flex min-h-12 w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-[#000052] p-3 font-medium text-white shadow-sm transition-all duration-200 ease-out hover:bg-[#0a1a7a] hover:shadow-md active:scale-95" do %>
              <%= material_icon "login" %> <%= t(".submit") %>
            <% end %>
          <% end %>
        </div>

        <p class="mt-6 text-center text-xs text-sky-100/80 lg:hidden">&copy; <%= Date.current.year %> Soluciones Campos</p>
      </div>
    </section>
  </div>
</div>
