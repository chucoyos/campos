<% scope = "yard_areas.guide" %>
<%= render "shared/quick_guide", title: t("#{scope}.title") do %>
  <p><%= t("#{scope}.intro") %></p>

  <% %w[areas sections slots map].each do |key| %>
    <section>
      <h3 class="mb-1 flex items-center gap-2 font-semibold text-slate-900">
        <%= material_icon t("#{scope}.#{key}.icon"), classes: "!text-xl text-indigo-600" %> <%= t("#{scope}.#{key}.title") %>
      </h3>
      <ol class="list-decimal space-y-1 pl-6">
        <% I18n.t("#{scope}.#{key}.steps").each do |step| %><li><%= step %></li><% end %>
      </ol>
    </section>
  <% end %>

  <p class="rounded-2xl bg-amber-50 p-3 text-amber-800"><%= t("#{scope}.tip") %></p>
<% end %>
