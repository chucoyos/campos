<% input = "w-full rounded-2xl border border-slate-200 bg-white p-3 focus:border-indigo-500 focus:outline-none" %>
<%= form_with model: yard_area, class: "space-y-5" do |f| %>
  <% if yard_area.errors.any? %>
    <div class="flex gap-3 rounded-2xl bg-red-50 p-4 text-sm text-red-700" role="alert">
      <%= material_icon "error" %>
      <ul>
        <% yard_area.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :code, class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :code, autofocus: true, class: input %>
    </div>
    <div>
      <%= f.label :name, class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :name, class: input %>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :yard_block_id, class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.collection_select :yard_block_id, YardBlock.order(:code), :id, :code, { prompt: t(".block_prompt") }, class: input %>
    </div>
    <div>
      <%= f.label :client_id, class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.collection_select :client_id, Client.order(:name), :id, :name, { include_blank: t(".client_prompt") }, class: input %>
    </div>
  </div>

  <label class="flex min-h-12 items-center gap-3 text-sm font-medium text-slate-700">
    <%= f.check_box :active, class: "h-5 w-5 rounded" %> <%= YardArea.human_attribute_name(:active) %>
  </label>

  <div class="flex flex-wrap items-center gap-3 pt-2">
    <%= f.button class: "flex min-h-12 cursor-pointer items-center gap-2 rounded-2xl bg-indigo-600 px-5 font-medium text-white transition-colors hover:bg-indigo-700" do %>
      <%= material_icon "save" %> <%= yard_area.persisted? ? t("shared.actions.save") : t("shared.actions.create") %>
    <% end %>
    <%= link_to yard_areas_path, class: "flex min-h-12 items-center gap-2 rounded-2xl px-5 font-medium text-slate-600 transition-colors hover:bg-slate-100" do %>
      <%= material_icon "close" %> <%= t("shared.actions.cancel") %>
    <% end %>
  </div>
<% end %>
