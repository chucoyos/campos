<% input = "w-full rounded-2xl border border-slate-200 bg-white p-3 focus:border-indigo-500 focus:outline-none" %>
<% label = "mb-1 block text-sm font-medium text-slate-700" %>
<div class="mx-auto w-full max-w-3xl">
  <%= link_to container_assignments_path, class: "mb-4 inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-800" do %>
    <%= material_icon "arrow_back" %> <%= t("shared.actions.back") %>
  <% end %>

  <div class="space-y-6 rounded-3xl border border-slate-100 bg-white p-8 shadow-sm">
    <div class="flex items-center gap-3">
      <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600"><%= material_icon "assignment" %></span>
      <div>
        <h1 class="text-2xl font-bold text-slate-900"><%= t(".title") %></h1>
        <p class="text-sm text-slate-500"><%= t(".subtitle") %></p>
      </div>
    </div>

    <%= form_with url: new_container_assignment_path, method: :get, class: "flex flex-col gap-3 sm:flex-row sm:items-end" do %>
      <div class="flex-1">
        <%= label_tag :master_bl_id, MasterBl.model_name.human, class: label %>
        <%= select_tag :master_bl_id, options_for_select(@master_bls.map { |bl| [ "#{bl.number} · #{bl.client.name}", bl.id ] }, @master_bl&.id), prompt: t(".master_bl_prompt"), class: input %>
      </div>
      <%= hidden_field_tag :operation, @assignment.operation, id: nil %>
      <%= button_tag class: "flex min-h-12 cursor-pointer items-center justify-center gap-2 rounded-2xl border border-slate-200 px-5 font-medium text-slate-700 hover:bg-slate-100" do %>
        <%= material_icon "search" %> <%= t(".load_containers") %>
      <% end %>
    <% end %>

    <% if @master_bl %>
      <%= form_with model: @assignment, url: container_assignments_path, scope: :container_assignment, class: "space-y-5" do |f| %>
        <% if @errors.present? || @assignment.errors.any? %>
          <div class="flex gap-3 rounded-2xl bg-red-50 p-4 text-sm text-red-700" role="alert">
            <%= material_icon "error" %>
            <ul>
              <% (@errors.to_a + @assignment.errors.full_messages).each do |message| %><li><%= message %></li><% end %>
            </ul>
          </div>
        <% end %>
        <%= hidden_field_tag :master_bl_id, @master_bl.id, id: nil %>

        <fieldset>
          <legend class="<%= label %>"><%= Container.model_name.human(count: 2) %></legend>
          <% if @containers.empty? %>
            <p class="text-sm text-slate-500"><%= t(".no_containers") %></p>
          <% end %>
          <div class="grid gap-2 sm:grid-cols-2">
            <% @containers.each do |container| %>
              <label class="flex min-h-12 cursor-pointer items-center gap-3 rounded-2xl border border-slate-200 px-4 transition-all duration-200 ease-out hover:bg-slate-50 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50">
                <%= check_box_tag "container_ids[]", container.id, @selected_ids.include?(container.id), id: "container_#{container.id}", class: "h-5 w-5" %>
                <span class="font-mono"><%= container.number %></span>
                <span class="text-xs text-slate-500"><%= t("containers.sizes.#{container.size}") %></span>
              </label>
            <% end %>
          </div>
        </fieldset>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= f.label :carrier_id, class: label %>
            <%= f.collection_select :carrier_id, @carriers, :id, :name, { prompt: t(".carrier_prompt"), selected: @assignment.carrier_id }, required: true, class: input %>
          </div>
          <div>
            <%= f.label :operation, class: label %>
            <%= f.select :operation, ContainerAssignment::OPERATIONS.map { |op| [ t("container_assignments.operations.#{op}"), op ] }, {}, class: input %>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="container_assignment_destination" class="<%= label %>"><%= t(".destination") %></label>
            <select name="container_assignment[destination]" id="container_assignment_destination" class="<%= input %>">
              <option value=""><%= t(".no_destination") %></option>
              <% @areas.each do |area| %>
                <optgroup label="<%= area.code %> · <%= area.name %><%= " (#{area.client.name})" if area.client %>">
                  <option value="area:<%= area.id %>"><%= t(".whole_area") %></option>
                  <% area.sections.select { |s| s.active && (s.master_bl_id.nil? || s.master_bl_id == @master_bl.id) }.each do |section| %>
                    <option value="section:<%= section.id %>"><%= section.name %></option>
                  <% end %>
                </optgroup>
              <% end %>
            </select>
            <p class="mt-1 text-xs text-slate-500"><%= t(".destination_hint") %></p>
          </div>
          <div>
            <%= f.label :preferred_level, class: label %>
            <%= f.number_field :preferred_level, min: 1, class: input %>
            <p class="mt-1 text-xs text-slate-500"><%= t(".level_hint") %></p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3 pt-2">
          <%= f.button class: "flex min-h-12 cursor-pointer items-center gap-2 rounded-2xl bg-indigo-600 px-5 font-medium text-white transition-colors hover:bg-indigo-700" do %>
            <%= material_icon "save" %> <%= t(".submit") %>
          <% end %>
          <%= link_to container_assignments_path, class: "flex min-h-12 items-center gap-2 rounded-2xl px-5 font-medium text-slate-600 hover:bg-slate-100" do %>
            <%= material_icon "close" %> <%= t("shared.actions.cancel") %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
