<%= form_with model: @cargo_packaging, class: "space-y-5 rounded-3xl border border-slate-100 bg-white p-6 shadow-sm" do |f| %>
  <% if @cargo_packaging.errors.any? %>
    <div class="rounded-2xl bg-red-50 p-4 text-sm text-red-700" role="alert">
      <ul class="list-disc pl-5"><% @cargo_packaging.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>
  <div>
    <%= f.label :code, class: "mb-1 block text-sm font-medium text-slate-700" %>
    <%= f.text_field :code, required: true, disabled: @cargo_packaging.persisted?, class: "min-h-12 w-full rounded-lg border border-slate-300 px-3 disabled:bg-slate-100" %>
    <% if @cargo_packaging.persisted? %><%= f.hidden_field :code %><% end %>
  </div>
  <div>
    <%= f.label :name, class: "mb-1 block text-sm font-medium text-slate-700" %>
    <%= f.text_field :name, required: true, class: "min-h-12 w-full rounded-lg border border-slate-300 px-3" %>
  </div>
  <div>
    <%= f.label :tracking_mode, class: "mb-1 block text-sm font-medium text-slate-700" %>
    <%= f.select :tracking_mode, CargoPackaging::TRACKING_MODES.map { |mode| [t("cargo_packagings.tracking_modes.#{mode}"), mode] }, {},
          class: "min-h-12 w-full rounded-lg border border-slate-300 bg-white px-3" %>
  </div>
  <% %i[weight_required qr_allowed active].each do |attribute| %>
    <label class="flex min-h-12 items-center gap-3 text-sm text-slate-700">
      <%= f.check_box attribute, class: "h-5 w-5 rounded border-slate-300 text-indigo-600" %>
      <%= f.label attribute %>
    </label>
  <% end %>
  <div class="flex flex-wrap gap-3">
    <%= f.button class: "flex min-h-12 items-center gap-2 rounded-full bg-indigo-600 px-5 font-medium text-white hover:bg-indigo-700" do %>
      <%= material_icon "save" %> <%= t("shared.actions.save") %>
    <% end %>
    <%= link_to t("shared.actions.cancel"), cargo_packagings_path, class: "flex min-h-12 items-center rounded-full px-5 font-medium text-slate-700 hover:bg-slate-100" %>
  </div>
<% end %>
