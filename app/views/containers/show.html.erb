<div class="mx-auto w-full max-w-4xl">
  <%= link_to containers_path, class: "mb-4 inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-800" do %>
    <%= material_icon "arrow_back" %> <%= t("shared.actions.back") %>
  <% end %>

  <div class="rounded-3xl border border-slate-100 bg-white p-8 shadow-sm">
    <div class="mb-6 flex items-center gap-4">
      <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600">
        <%= material_icon "inventory_2", classes: "!text-3xl" %>
      </span>
      <div>
        <h1 class="text-2xl font-bold text-slate-900"><%= @container.number %></h1>
        <%= render "status", container: @container %>
        <% if @container.pending_placement? %>
          <span class="ml-1 inline-flex items-center gap-1 rounded-lg bg-amber-100 px-2.5 py-1 text-xs font-medium text-amber-800"><%= material_icon "precision_manufacturing", classes: "!text-sm" %> <%= t("crane.pending_badge") %></span>
        <% end %>
      </div>
    </div>

    <dl class="grid gap-4 rounded-2xl bg-slate-50 p-4 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-slate-500"><%= Container.human_attribute_name(:size) %></dt>
        <dd class="font-medium text-slate-800"><%= t("containers.sizes.#{@container.size}") %></dd>
      </div>
      <div>
        <dt class="text-slate-500"><%= Container.human_attribute_name(:container_type) %></dt>
        <dd class="font-medium text-slate-800"><%= t("containers.types.#{@container.container_type}") %></dd>
      </div>
      <div>
        <dt class="text-slate-500"><%= Container.human_attribute_name(:master_bl) %></dt>
        <dd class="font-medium text-slate-800">
          <% if @container.master_bl && policy(@container.master_bl).show? %>
            <%= link_to @container.master_bl.number, master_bl_path(@container.master_bl), class: "text-indigo-600 hover:underline" %>
          <% elsif @container.master_bl %>
            <%= @container.master_bl.number %>
          <% else %>
            <%= t(".no_master_bl") %>
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-slate-500"><%= Container.human_attribute_name(:created_at) %></dt>
        <dd class="font-medium text-slate-800"><%= l(@container.created_at, format: :long) %></dd>
      </div>
      <div>
        <dt class="text-slate-500"><%= Container.human_attribute_name(:updated_at) %></dt>
        <dd class="font-medium text-slate-800"><%= l(@container.updated_at, format: :long) %></dd>
      </div>
    </dl>

    <% if policy(@container).update? %>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <%= link_to edit_container_path(@container), class: "flex min-h-12 items-center gap-2 rounded-2xl bg-indigo-600 px-5 font-medium text-white transition-colors hover:bg-indigo-700" do %>
        <%= material_icon "edit" %> <%= t("shared.actions.edit") %>
      <% end %>
      <% if policy(@container).destroy? %>
      <%= button_to container_path(@container), method: :delete,
            form: { data: { turbo_confirm: t("shared.actions.confirm_destroy", name: @container.number) } },
            class: "flex min-h-12 cursor-pointer items-center gap-2 rounded-2xl px-5 font-medium text-red-600 transition-colors hover:bg-red-50" do %>
        <%= material_icon "delete" %> <%= t("shared.actions.destroy") %>
      <% end %>
      <% end %>
    </div>
    <% end %>
  </div>

  <% if @cargo_manifest %>
    <div class="mt-6">
      <%= render "cargo_manifests/items", manifest: @cargo_manifest, items: @cargo_items, new_item: @new_cargo_item, packagings: @active_packagings %>
    </div>
  <% elsif @new_cargo_manifest && policy(@new_cargo_manifest).create? %>
    <section class="mt-6 rounded-3xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-lg font-bold text-slate-900"><%= t("cargo_manifests.show.items_title") %></h2>
      <p class="mb-4 mt-1 text-sm text-slate-500"><%= t(".cargo_empty") %></p>
      <%= button_to cargo_manifests_path, method: :post,
            params: { return_to: "container", cargo_manifest: { container_id: @container.id, client_id: @new_cargo_manifest.client_id } },
            class: "flex min-h-12 cursor-pointer items-center gap-2 rounded-full bg-indigo-600 px-5 font-medium text-white transition-all duration-200 ease-out hover:bg-indigo-700 active:scale-95" do %>
        <%= material_icon "add" %> <%= t(".cargo_start") %>
      <% end %>
    </section>
  <% end %>

  <% if policy(@container).photos? %>
  <section class="mt-6 rounded-3xl border border-slate-100 bg-white p-8 shadow-sm">
    <h2 class="flex items-center gap-3 text-lg font-bold text-slate-900">
      <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600">
        <%= material_icon "photo_camera" %>
      </span>
      <%= t(".photos_title") %>
    </h2>
    <p class="mb-4 mt-1 text-sm text-slate-500"><%= t(".photos_hint") %></p>

    <div class="space-y-3">
      <% Container::PHOTO_SECTIONS.each do |section| %>
        <%= render "photo_section", container: @container, section: section,
              count: @photo_counts.fetch("#{section}_photos", 0) %>
      <% end %>
    </div>
  </section>
  <% end %>

  <% if @movements.any? %>
    <section class="mt-6 rounded-3xl border border-slate-100 bg-white p-5 shadow-sm sm:p-8">
      <h2 class="mb-4 flex items-center gap-3 text-lg font-bold text-slate-900">
        <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600"><%= material_icon "history" %></span>
        <%= t(".movement_history") %>
      </h2>
      <div class="space-y-3">
        <% @movements.each do |movement| %>
          <%= render "movement_section", movement: movement %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
