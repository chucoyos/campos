<%= render "shared/row_actions", label: t("shared.actions.title_named", name: container.number), items: [
  { label: t("shared.actions.show"), icon: "visibility", href: container_path(container) },
  (policy(container).update? ? { label: t("shared.actions.edit"), icon: "edit", href: edit_container_path(container) } : nil),
  (policy(container).destroy? ? { label: t("shared.actions.destroy"), icon: "delete", href: container_path(container), method: :delete,
                                  confirm: t("shared.actions.confirm_destroy", name: container.number), tone: :danger } : nil)
] %>
