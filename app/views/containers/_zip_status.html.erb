<%# Estado de la descarga ZIP de una sección; el job lo reemplaza por Turbo Stream. %>
<% state = local_assigns.fetch(:state, :idle) %>
<% done = local_assigns[:done].to_i %>
<% total = local_assigns[:total].to_i %>
<% percent = total.positive? ? [ (done * 100.0 / total).round, 4 ].max : 4 %>
<div id="<%= dom_id(container, "zip_#{section}") %>" class="rounded-2xl">
  <% case state %>
  <% when :working %>
    <div class="space-y-3 rounded-2xl border border-indigo-100 bg-indigo-50 p-4" role="status" aria-live="polite"
         data-controller="zip-wait" data-zip-wait-messages-value="<%= t("containers.photos.zip.messages").to_json %>">
      <div class="flex items-center gap-3">
        <span class="relative flex h-10 w-10 items-center justify-center rounded-full bg-indigo-600 text-white">
          <span class="absolute inset-0 animate-ping rounded-full bg-indigo-400 opacity-40"></span>
          <%= material_icon "folder_zip", classes: "relative animate-bounce" %>
        </span>
        <div class="min-w-0 flex-1">
          <p class="font-medium text-indigo-900"><%= t("containers.photos.zip.working") %></p>
          <p class="truncate text-sm text-indigo-700 transition-opacity duration-300" data-zip-wait-target="message"><%= t("containers.photos.zip.messages").first %></p>
        </div>
        <% if total.positive? %>
          <span class="text-sm font-medium tabular-nums text-indigo-800"><%= done %>/<%= total %></span>
        <% end %>
      </div>
      <div class="h-3 w-full overflow-hidden rounded-full bg-indigo-100">
        <div class="relative h-full overflow-hidden rounded-full bg-indigo-600 transition-all duration-500 ease-out" style="width: <%= percent %>%">
          <span class="absolute inset-0 animate-pulse bg-white/30"></span>
        </div>
      </div>
      <p class="text-xs text-indigo-700"><%= t("containers.photos.zip.keep_browsing") %></p>
    </div>
  <% when :ready %>
    <div class="flex flex-wrap items-center gap-3 rounded-2xl border border-emerald-200 bg-emerald-50 p-4" role="status">
      <%= material_icon "task_alt", classes: "text-emerald-600" %>
      <p class="flex-1 font-medium text-emerald-900"><%= t("containers.photos.zip.ready") %></p>
      <%= link_to url, data: { turbo: false },
            class: "flex min-h-12 items-center gap-2 rounded-full bg-emerald-600 px-5 font-medium text-white shadow-sm transition-all duration-200 ease-out hover:bg-emerald-700 active:scale-95" do %>
        <%= material_icon "download" %> <%= t("containers.photos.zip.download") %>
      <% end %>
      <p class="w-full text-xs text-emerald-800"><%= t("containers.photos.zip.expires") %></p>
    </div>
  <% when :failed %>
    <div class="flex flex-wrap items-center gap-3 rounded-2xl border border-red-200 bg-red-50 p-4" role="alert">
      <%= material_icon "error", classes: "text-red-600" %>
      <p class="flex-1 text-sm font-medium text-red-800"><%= t("containers.photos.zip.failed") %></p>
      <%= button_to zip_photos_container_path(container, section: section), method: :post,
            class: "flex min-h-12 cursor-pointer items-center gap-2 rounded-2xl bg-red-100 px-4 font-medium text-red-800 transition-all duration-200 ease-out hover:bg-red-200 active:scale-95" do %>
        <%= material_icon "refresh" %> <%= t("containers.photos.zip.retry") %>
      <% end %>
    </div>
  <% else %>
    <%= button_to zip_photos_container_path(container, section: section), method: :post,
          class: "flex min-h-12 cursor-pointer items-center gap-2 rounded-2xl bg-indigo-50 px-4 font-medium text-indigo-700 transition-all duration-200 ease-out hover:bg-indigo-100 active:scale-95" do %>
      <%= material_icon "folder_zip" %> <%= t("containers.photos.zip.prepare") %>
    <% end %>
  <% end %>
</div>
