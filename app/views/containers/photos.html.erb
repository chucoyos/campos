<%= turbo_frame_tag "photos_#{@section}" do %>
  <% if @photos.empty? %>
    <p class="text-sm text-slate-500"><%= t("containers.photos.empty_section") %></p>
  <% else %>
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      <% @photos.each do |photo| %>
        <li class="group/photo relative aspect-square overflow-hidden rounded-2xl bg-slate-200 shadow-sm">
          <%# Solo las fotos visibles en pantalla se descargan (lazy) y se sirven directo desde S3 con URL firmada. %>
          <%= link_to photo.url(expires_in: 1.hour), target: "_top", rel: "noopener", aria: { label: t("containers.photos.open_photo") }, data: { turbo: false }, class: "block h-full w-full" do %>
            <img src="<%= photo.url(expires_in: 1.hour) %>" alt="<%= photo.filename %>" loading="lazy" decoding="async"
                 class="h-full w-full object-cover transition-transform duration-200 ease-out group-hover/photo:scale-105">
          <% end %>
          <%= button_to remove_photo_container_path(@container, photo_id: photo.id), method: :delete, form: { data: { turbo_frame: "_top", turbo_confirm: t("containers.photos.confirm_remove") } },
                title: t("containers.photos.remove"), aria: { label: t("containers.photos.remove") },
                class: "absolute right-2 top-2 flex h-12 w-12 cursor-pointer items-center justify-center rounded-full bg-white/90 text-red-600 shadow-sm transition-all duration-200 ease-out hover:bg-red-50 active:scale-95" do %>
            <%= material_icon "delete" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
