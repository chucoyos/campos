<% input = "min-h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600/20" %>
<div class="mx-auto w-full max-w-3xl">
  <%= link_to work_schedules_path, class: "mb-4 inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-800" do %>
    <%= material_icon "arrow_back" %> <%= t("shared.actions.back") %>
  <% end %>

  <div class="space-y-6 rounded-3xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
    <div class="flex items-center gap-3">
      <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600"><%= material_icon "event_note" %></span>
      <div>
        <h1 class="text-2xl font-bold text-slate-900"><%= t(".title") %></h1>
        <p class="text-sm text-slate-500"><%= t(".subtitle") %></p>
      </div>
    </div>

    <%= form_with url: new_work_schedule_path, method: :get, class: "flex flex-wrap gap-3" do |f| %>
      <%= f.label :master_bl_id, t(".master_bl"), class: "sr-only" %>
      <%= f.select :master_bl_id, @master_bls.map { |master_bl| [ master_bl.number, master_bl.id ] },
            { selected: @master_bl&.id, prompt: t(".choose_master_bl") }, required: true, class: "#{input} flex-1" %>
      <%= f.button class: "flex min-h-12 items-center gap-2 rounded-full bg-indigo-600 px-5 font-medium text-white transition-all duration-200 ease-out hover:bg-indigo-700 active:scale-95" do %>
        <%= material_icon "search" %> <%= t(".load_containers") %>
      <% end %>
    <% end %>

    <% if @master_bl %>
      <% if @candidates.empty? %>
        <p class="rounded-2xl bg-amber-50 p-4 text-sm text-amber-900"><%= t(".none_in_yard") %></p>
      <% else %>
        <%= form_with url: work_schedules_path, class: "space-y-5" do |f| %>
          <%= hidden_field_tag :master_bl_id, @master_bl.id, id: nil %>
          <fieldset>
            <legend class="mb-2 text-sm font-medium text-slate-700"><%= t(".containers") %></legend>
            <ul class="divide-y divide-slate-100 rounded-2xl border border-slate-100">
              <% @candidates.each do |container, busy| %>
                <li>
                  <label class="flex min-h-14 cursor-pointer items-center gap-3 p-3 <%= "opacity-50" if busy %>">
                    <%= check_box_tag "container_ids[]", container.id, !busy, id: dom_id(container, :schedule), disabled: busy, class: "h-6 w-6 rounded border-slate-300 text-indigo-600" %>
                    <span class="font-mono font-semibold text-slate-900"><%= container.number %></span>
                    <span class="text-sm text-slate-600"><%= container.current_yard_slot.code %> · <%= t("containers.sizes.#{container.size}") %></span>
                    <% if busy %><span class="ml-auto text-xs text-amber-700"><%= t(".busy") %></span><% end %>
                  </label>
                </li>
              <% end %>
            </ul>
          </fieldset>
          <div>
            <%= f.label :scheduled_for, t(".scheduled_for"), class: "mb-1 block text-sm font-medium text-slate-700" %>
            <%= f.date_field :scheduled_for, value: @schedule.scheduled_for, required: true, class: input %>
          </div>
          <div>
            <%= f.label :notes, t(".notes"), class: "mb-1 block text-sm font-medium text-slate-700" %>
            <%= f.text_area :notes, rows: 2, class: "w-full rounded-2xl border border-slate-300 bg-white p-3 focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600/20" %>
          </div>
          <%= f.button class: "flex min-h-14 w-full items-center justify-center gap-2 rounded-full bg-emerald-600 px-6 font-semibold text-white shadow-sm transition-all duration-200 ease-out hover:bg-emerald-700 active:scale-95" do %>
            <%= material_icon "event_available" %> <%= t(".submit") %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
