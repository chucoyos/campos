<div class="mx-auto w-full max-w-3xl">
  <%= link_to work_schedules_path, class: "mb-4 inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-800" do %>
    <%= material_icon "arrow_back" %> <%= t("shared.actions.back") %>
  <% end %>

  <div class="space-y-5 rounded-3xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h1 class="text-2xl font-bold text-slate-900"><%= l(@schedule.scheduled_for, format: :long) %></h1>
        <p class="text-sm text-slate-600"><%= @schedule.master_bl&.number || t("work_schedules.index.no_master_bl") %></p>
      </div>
      <%= render "work_schedules/status", schedule: @schedule %>
    </div>

    <% if @schedule.notes.present? %>
      <p class="rounded-2xl bg-slate-50 p-4 text-sm text-slate-700"><%= @schedule.notes %></p>
    <% end %>

    <ul class="divide-y divide-slate-100 rounded-2xl border border-slate-100">
      <% @rows.each do |row| %>
        <li class="flex flex-wrap items-center justify-between gap-3 p-4">
          <div>
            <p class="font-mono font-semibold text-slate-900"><%= row.container.number %></p>
            <p class="text-sm text-slate-600">
              <%= row.origin&.code || "—" %> <%= material_icon "arrow_forward", classes: "!text-base align-middle" %> <%= row.destination&.code || "DESYCON" %>
            </p>
            <% if row.blocked %><p class="text-xs text-amber-700"><%= t(".blocked") %></p><% end %>
          </div>
          <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700"><%= t("work_schedules.row_statuses.#{row.status}") %></span>
        </li>
      <% end %>
    </ul>

    <% if policy(@schedule).cancel? %>
      <%= button_to cancel_work_schedule_path(@schedule), method: :patch,
            form: { data: { turbo_confirm: t(".confirm_cancel") } },
            class: "flex min-h-12 items-center justify-center gap-2 rounded-full border border-slate-300 px-6 font-medium text-slate-700 transition-all duration-200 ease-out hover:bg-slate-100 active:scale-95" do %>
        <%= material_icon "close" %> <%= t(".cancel") %>
      <% end %>
    <% end %>
  </div>
</div>
