<%= render "shared/row_actions", label: t("shared.actions.title_named", name: client.name), items: [
  { label: t("shared.actions.show"), icon: "visibility", href: client_path(client) },
  { label: t("shared.actions.edit"), icon: "edit", href: edit_client_path(client) },
  { label: t("shared.actions.destroy"), icon: "delete", href: client_path(client), method: :delete,
    confirm: t("shared.actions.confirm_destroy", name: client.name), tone: :danger }
] %>
