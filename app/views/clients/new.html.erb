<div class="mx-auto w-full max-w-2xl">
  <%= link_to clients_path, class: "mb-4 inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-800" do %>
    <%= material_icon "arrow_back" %> <%= t("shared.actions.back") %>
  <% end %>

  <div class="rounded-3xl border border-slate-100 bg-white p-8 shadow-sm">
    <div class="mb-6 flex items-center gap-3">
      <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600">
        <%= material_icon "person_search" %>
      </span>
      <div>
        <h1 class="text-2xl font-bold text-slate-900"><%= t(".title") %></h1>
        <p class="text-sm text-slate-500"><%= t(".subtitle") %></p>
      </div>
    </div>

    <%= render "form", client: @client %>
  </div>
</div>
