<div class="mx-auto w-full max-w-2xl">
  <%= link_to clients_path, class: "mb-4 inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-800" do %>
    <%= material_icon "arrow_back" %> <%= t("shared.actions.back") %>
  <% end %>

  <div class="rounded-3xl border border-slate-100 bg-white p-8 shadow-sm">
    <div class="mb-6 flex items-center gap-4">
      <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600">
        <%= material_icon "person_search", classes: "!text-3xl" %>
      </span>
      <h1 class="text-2xl font-bold text-slate-900"><%= @client.name %></h1>
    </div>

    <dl class="grid gap-4 rounded-2xl bg-slate-50 p-4 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-slate-500"><%= Client.human_attribute_name(:created_at) %></dt>
        <dd class="font-medium text-slate-800"><%= l(@client.created_at, format: :long) %></dd>
      </div>
      <div>
        <dt class="text-slate-500"><%= Client.human_attribute_name(:updated_at) %></dt>
        <dd class="font-medium text-slate-800"><%= l(@client.updated_at, format: :long) %></dd>
      </div>
    </dl>

    <%= form_with model: @client, class: "mt-4 flex flex-wrap items-center gap-3 rounded-2xl bg-slate-50 p-4" do |f| %>
      <%= hidden_field_tag :from, "show" %>
      <%= f.label :container_color, class: "flex items-center gap-2 text-sm font-medium text-slate-700" do %>
        <%= material_icon "palette" %> <%= Client.human_attribute_name(:container_color) %>
      <% end %>
      <%= f.color_field :container_color, value: @client.container_color || "#dc2626", class: "h-12 w-16 cursor-pointer rounded-lg border border-slate-200 bg-white p-1" %>
      <%= f.button class: "flex min-h-12 cursor-pointer items-center gap-2 rounded-2xl bg-indigo-600 px-5 font-medium text-white transition-colors hover:bg-indigo-700" do %>
        <%= material_icon "save" %> <%= t("shared.actions.save") %>
      <% end %>
      <% if @client.container_color %>
        <%= f.button name: "client[container_color]", value: "", class: "flex min-h-12 cursor-pointer items-center gap-2 rounded-2xl px-5 font-medium text-slate-600 transition-colors hover:bg-slate-100" do %>
          <%= material_icon "format_color_reset" %> <%= t("clients.show.clear_color") %>
        <% end %>
      <% end %>
      <p class="w-full text-xs text-slate-500"><%= t("clients.show.color_hint") %></p>
    <% end %>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <%= link_to edit_client_path(@client), class: "flex min-h-12 items-center gap-2 rounded-2xl bg-indigo-600 px-5 font-medium text-white transition-colors hover:bg-indigo-700" do %>
        <%= material_icon "edit" %> <%= t("shared.actions.edit") %>
      <% end %>
      <%= button_to client_path(@client), method: :delete,
            form: { data: { turbo_confirm: t("shared.actions.confirm_destroy", name: @client.name) } },
            class: "flex min-h-12 cursor-pointer items-center gap-2 rounded-2xl px-5 font-medium text-red-600 transition-colors hover:bg-red-50" do %>
        <%= material_icon "delete" %> <%= t("shared.actions.destroy") %>
      <% end %>
    </div>
  </div>

  <%= render "shared/related_users", owner: @client, users: @users, linkable_users: @linkable_users,
        role: "cliente", link_path: link_user_client_path(@client),
        unlink_path: ->(user) { unlink_user_client_path(@client, user_id: user.id) },
        new_path: new_user_path(role: "cliente", client_id: @client.id) %>
</div>
