<div class="mx-auto w-full max-w-3xl">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600"><%= material_icon "qr_code_scanner" %></span>
      <div>
        <h1 class="text-2xl font-bold text-slate-900 sm:text-3xl"><%= t(".title") %></h1>
        <p class="text-sm text-slate-600"><%= t(@pass.entered_at? ? ".exit_description" : ".description") %></p>
      </div>
    </div>
    <%= link_to gate_path, class: "flex min-h-12 items-center gap-2 rounded-full border border-slate-300 px-5 font-medium text-slate-700 hover:bg-slate-100" do %>
      <%= material_icon "qr_code_scanner" %> <%= t(".scan_another") %>
    <% end %>
  </div>

  <% if @error.present? %>
    <div class="mb-5 flex items-start gap-3 rounded-2xl border border-red-200 bg-red-50 p-4 text-red-800" role="alert">
      <%= material_icon "error" %><p><%= @error %></p>
    </div>
  <% end %>

  <section class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="text-sm font-medium text-slate-500"><%= t(".container") %></p>
        <h2 class="mt-1 text-xl font-bold text-slate-900"><%= @pass.container.number %></h2>
      </div>
      <span class="rounded-full bg-emerald-100 px-4 py-2 text-sm font-semibold text-emerald-800"><%= t("movement_passes.types.#{@pass.movement_type}") %></span>
    </div>

    <dl class="mt-5 grid gap-3 rounded-2xl bg-slate-50 p-4 text-sm sm:grid-cols-2">
      <div><dt class="text-slate-500"><%= t(".operator") %></dt><dd class="font-medium text-slate-900"><%= @pass.vehicle("principal")&.operator_name %></dd></div>
      <div><dt class="text-slate-500"><%= t(".plate") %></dt><dd class="font-medium text-slate-900"><%= @pass.vehicle("principal")&.plate %></dd></div>
      <% if @pass.client %>
        <div><dt class="text-slate-500"><%= t(".client") %></dt><dd class="font-medium text-slate-900"><%= @pass.client.name %></dd></div>
      <% end %>
      <% if @pass.load_status %>
        <div><dt class="text-slate-500"><%= t(".load_status") %></dt><dd class="font-medium text-slate-900"><%= t("movement_passes.load_statuses.#{@pass.load_status}") %></dd></div>
      <% end %>
    </dl>

    <% if @pass.traspaleo? %>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <% @pass.vehicles.sort_by { |vehicle| MovementPassVehicle::ROLES.index(vehicle.role) }.each do |vehicle| %>
          <div class="rounded-2xl bg-slate-50 p-4 text-sm">
            <p class="font-semibold text-slate-900"><%= t("movement_passes.pdf.vehicle_#{vehicle.role}") %></p>
            <p class="mt-1"><%= vehicle.operator_name %> · <%= vehicle.plate %></p>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>

  <% unless @pass.entered_at? %>
  <section class="mt-5 space-y-4 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
    <div>
      <h2 class="flex items-center gap-2 text-lg font-bold text-slate-900"><%= material_icon "photo_camera" %> <%= t(".photos_title") %></h2>
      <p class="mt-1 text-sm text-slate-600"><%= t(".photos_hint") %></p>
    </div>
    <%= form_with url: gate_movement_photos_path(@pass), method: :post, multipart: true,
          data: { controller: "photo-upload", photo_upload_max_value: Container::MAX_PHOTOS_PER_UPLOAD,
                  photo_upload_too_many_value: t("containers.photos.too_many", max: Container::MAX_PHOTOS_PER_UPLOAD),
                  photo_upload_failed_value: t("containers.photos.failed") },
          class: "flex flex-wrap items-center gap-3 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-3" do |f| %>
      <%= f.label :photos, t(".photos_input"), class: "sr-only" %>
      <%= f.file_field :photos, multiple: true, accept: Container::PHOTO_CONTENT_TYPES.join(","), direct_upload: true,
            data: { photo_upload_target: "input", action: "change->photo-upload#prepare" },
            class: "min-h-12 w-full flex-1 text-sm text-slate-600 file:mr-3 file:min-h-12 file:cursor-pointer file:rounded-2xl file:border-0 file:bg-indigo-50 file:px-4 file:font-medium file:text-indigo-700 hover:file:bg-indigo-100 sm:w-auto" %>
      <%= f.button disabled: true, data: { photo_upload_target: "submit" },
            class: "flex min-h-12 cursor-pointer items-center justify-center gap-2 rounded-2xl bg-indigo-600 px-5 font-medium text-white transition-all duration-200 ease-out hover:bg-indigo-700 active:scale-95 disabled:cursor-not-allowed disabled:opacity-50" do %>
        <%= material_icon "upload" %> <%= t(".upload_photos") %>
      <% end %>
      <div class="hidden h-2 w-full overflow-hidden rounded-full bg-slate-200" data-photo-upload-target="progress" role="progressbar" aria-label="<%= t("containers.photos.uploading") %>">
        <div class="h-full w-0 rounded-full bg-indigo-600 transition-all duration-200 ease-out" data-photo-upload-target="bar"></div>
      </div>
      <p class="hidden w-full text-sm text-red-700" data-photo-upload-target="error" role="alert"></p>
    <% end %>
    <% if @pass.errors[:photos].present? %>
      <p class="rounded-xl bg-red-50 p-3 text-sm text-red-800" role="alert"><%= @pass.errors.full_messages_for(:photos).to_sentence %></p>
    <% end %>

    <% if @pass.photos.attached? %>
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        <% @pass.photos_attachments.includes(:blob).each do |photo| %>
          <li class="group/photo relative aspect-square overflow-hidden rounded-2xl bg-slate-200 shadow-sm">
            <%= link_to rails_blob_url(photo, expires_in: 1.hour), target: "_blank", rel: "noopener", aria: { label: t("containers.photos.open_photo") }, data: { turbo: false }, class: "block h-full w-full" do %>
              <img src="<%= rails_blob_url(photo, expires_in: 1.hour) %>" alt="<%= photo.filename %>" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-200 ease-out group-hover/photo:scale-105">
            <% end %>
            <%= button_to remove_gate_movement_photo_path(@pass, photo_id: photo.id), method: :delete,
                  form: { data: { turbo_confirm: t(".confirm_remove_photo") } }, title: t("containers.photos.remove"),
                  class: "absolute right-2 top-2 flex h-12 w-12 cursor-pointer items-center justify-center rounded-full bg-white/90 text-red-600 shadow-sm hover:bg-red-50" do %>
              <%= material_icon "delete" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-slate-500"><%= t(".photos_empty") %></p>
    <% end %>
  </section>
  <% end %>

  <% exit_movement = @pass.entered_at? ? @pass.movement : nil %>
  <% if exit_movement %>
  <section class="mt-5 space-y-4 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
    <div>
      <h2 class="flex items-center gap-2 text-lg font-bold text-slate-900"><%= material_icon "photo_camera" %> <%= t(".exit_photos_title") %></h2>
      <p class="mt-1 text-sm text-slate-600"><%= t(".exit_photos_hint") %></p>
    </div>
    <%= form_with url: gate_movement_exit_photos_path(@pass), method: :post, multipart: true,
          data: { controller: "photo-upload", photo_upload_max_value: Container::MAX_PHOTOS_PER_UPLOAD,
                  photo_upload_too_many_value: t("containers.photos.too_many", max: Container::MAX_PHOTOS_PER_UPLOAD),
                  photo_upload_failed_value: t("containers.photos.failed") },
          class: "flex flex-wrap items-center gap-3 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-3" do |f| %>
      <%= f.label :photos, t(".photos_input"), class: "sr-only" %>
      <%= f.file_field :photos, multiple: true, accept: Container::PHOTO_CONTENT_TYPES.join(","), direct_upload: true,
            data: { photo_upload_target: "input", action: "change->photo-upload#prepare" },
            class: "min-h-12 w-full flex-1 text-sm text-slate-600 file:mr-3 file:min-h-12 file:cursor-pointer file:rounded-2xl file:border-0 file:bg-indigo-50 file:px-4 file:font-medium file:text-indigo-700 hover:file:bg-indigo-100 sm:w-auto" %>
      <%= f.button disabled: true, data: { photo_upload_target: "submit" },
            class: "flex min-h-12 cursor-pointer items-center justify-center gap-2 rounded-2xl bg-indigo-600 px-5 font-medium text-white transition-all duration-200 ease-out hover:bg-indigo-700 active:scale-95 disabled:cursor-not-allowed disabled:opacity-50" do %>
        <%= material_icon "upload" %> <%= t(".upload_photos") %>
      <% end %>
      <div class="hidden h-2 w-full overflow-hidden rounded-full bg-slate-200" data-photo-upload-target="progress" role="progressbar" aria-label="<%= t("containers.photos.uploading") %>">
        <div class="h-full w-0 rounded-full bg-indigo-600 transition-all duration-200 ease-out" data-photo-upload-target="bar"></div>
      </div>
      <p class="hidden w-full text-sm text-red-700" data-photo-upload-target="error" role="alert"></p>
    <% end %>

    <% if exit_movement.exit_photos.attached? %>
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        <% exit_movement.exit_photos_attachments.includes(:blob).each do |photo| %>
          <li class="group/photo relative aspect-square overflow-hidden rounded-2xl bg-slate-200 shadow-sm">
            <%= link_to rails_blob_url(photo, expires_in: 1.hour), target: "_blank", rel: "noopener", aria: { label: t("containers.photos.open_photo") }, data: { turbo: false }, class: "block h-full w-full" do %>
              <img src="<%= rails_blob_url(photo, expires_in: 1.hour) %>" alt="<%= photo.filename %>" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-200 ease-out group-hover/photo:scale-105">
            <% end %>
            <%= button_to remove_gate_movement_exit_photo_path(@pass, photo_id: photo.id), method: :delete,
                  form: { data: { turbo_confirm: t(".confirm_remove_exit_photo") } }, title: t("containers.photos.remove"),
                  class: "absolute right-2 top-2 flex h-12 w-12 cursor-pointer items-center justify-center rounded-full bg-white/90 text-red-600 shadow-sm hover:bg-red-50" do %>
              <%= material_icon "delete" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-slate-500"><%= t(".exit_photos_empty") %></p>
    <% end %>
  </section>
  <% end %>

  <% if @pass.entered_at? %>
    <section class="mt-5 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
      <h2 class="flex items-center gap-2 text-lg font-bold text-slate-900"><%= material_icon "fact_check" %> <%= t(".verify_exit_title") %></h2>
      <p class="mt-2 text-sm text-slate-700">
        <%= t(".verify_exit_#{@pass.movement_type}", container: @pass.container.number) %>
      </p>
      <%= form_with url: complete_gate_movement_path(@pass), class: "mt-5" do |f| %>
        <%= f.button class: "flex min-h-14 w-full items-center justify-center gap-2 rounded-full bg-emerald-700 px-6 font-semibold text-white transition-all duration-200 ease-out hover:bg-emerald-800 active:scale-95" do %>
          <%= material_icon "verified" %> <%= t(".verify_exit") %>
        <% end %>
      <% end %>
    </section>
  <% elsif @pass.ingreso? %>
    <section class="mt-5 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8"
             data-controller="<%= 'yard-slot-search' if @location_options.present? %>"
             data-yard-slot-search-select-prompt-value="<%= t(".select_location") %>">
      <h2 class="flex items-center gap-2 text-lg font-bold text-slate-900"><%= material_icon "location_on" %> <%= t(".destination") %></h2>
      <p class="mb-4 mt-1 text-sm text-slate-600"><%= t(".location_hint") %></p>

      <% if @suggested_slot %>
        <p class="mb-3 rounded-xl bg-indigo-50 p-3 text-sm text-indigo-800">
          <%= material_icon("lightbulb") %> <%= t(".suggested", location: @suggested_slot.code) %>
        </p>
      <% end %>

      <% if @location_options.present? %>
        <label for="yard-slot-search" class="mb-2 block text-sm font-medium text-slate-700"><%= t(".search_location") %></label>
        <input id="yard-slot-search" type="search" autocomplete="off" placeholder="<%= t(".search_placeholder") %>"
               data-yard-slot-search-target="input" data-action="input->yard-slot-search#filter"
               class="min-h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600/20">
        <p class="mt-2 text-sm text-slate-600"><%= t(".selected_location") %>: <strong data-yard-slot-search-target="selected"><%= t(".select_location") %></strong></p>

        <ul class="mt-3 max-h-72 space-y-2 overflow-y-auto" aria-live="polite">
          <% @location_options.each do |option| %>
            <% slot = option[:slot] %>
            <% section = slot.yard_area_section %>
            <% label = [slot.code, section&.yard_area&.name, section&.name].compact.join(" · ") %>
            <% source_label = t(".location_sources.#{option[:source]}") %>
            <% search = [slot.code, slot.yard_block.code, section&.name, section&.yard_area&.name, source_label].compact.join(" ").downcase %>
            <li>
              <button type="button" data-yard-slot-search-target="result" data-action="yard-slot-search#choose"
                      data-slot-id="<%= slot.id %>" data-label="<%= label %>" data-source="<%= option[:source] %>" data-search="<%= search %>"
                      class="flex min-h-12 w-full items-center justify-between gap-3 rounded-2xl border border-slate-200 px-4 py-2 text-left transition-colors hover:border-indigo-300 hover:bg-indigo-50">
                <span class="min-w-0">
                  <span class="block font-semibold text-slate-900"><%= slot.code %></span>
                  <span class="block truncate text-xs text-slate-500"><%= [section&.yard_area&.name, section&.name].compact.join(" · ") %></span>
                </span>
                <span class="shrink-0 rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700"><%= source_label %></span>
              </button>
            </li>
          <% end %>
        </ul>
        <p data-yard-slot-search-target="empty" hidden class="mt-3 rounded-xl bg-amber-50 p-3 text-sm text-amber-800"><%= t(".location_no_match") %></p>
      <% else %>
        <p class="rounded-xl bg-amber-50 p-3 text-sm text-amber-800" role="alert"><%= t(".no_locations") %></p>
      <% end %>

      <%= form_with url: complete_gate_movement_path(@pass), class: "mt-5" do |f| %>
        <%= f.hidden_field :yard_slot_id, data: { yard_slot_search_target: "slotId" } %>
        <%= f.button disabled: true, data: { yard_slot_search_target: "submit" },
              class: "flex min-h-12 w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-emerald-700 px-6 font-semibold text-white transition-all duration-200 ease-out hover:bg-emerald-800 active:scale-95 disabled:cursor-not-allowed disabled:opacity-50" do %>
          <%= material_icon "task_alt" %> <%= t(".register_entry") %>
        <% end %>
      <% end %>
    </section>
  <% else %>
    <section class="mt-5 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
      <% if @pass.salida? %>
        <h2 class="text-lg font-bold text-slate-900"><%= t(".prepare_exit_title") %></h2>
        <p class="mt-2 text-sm text-slate-700"><%= t(".prepare_exit", container: @pass.container.number) %></p>
      <% end %>
      <%= form_with url: complete_gate_movement_path(@pass), class: "space-y-3" do |f| %>
        <%= f.button class: "flex min-h-12 w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-emerald-700 px-6 font-semibold text-white transition-all duration-200 ease-out hover:bg-emerald-800 active:scale-95" do %>
          <%= material_icon "task_alt" %> <%= t(@pass.traspaleo? ? ".complete" : ".register_entry") %>
        <% end %>
      <% end %>
    </section>
  <% end %>
</div>
