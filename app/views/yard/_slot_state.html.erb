<% label = t("yard.states.#{slot.enabled ? 'enabled' : 'disabled'}") %>
<% classes = slot.enabled ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-600" %>
<% if policy(slot).toggle? %>
  <%= button_to toggle_yard_slot_path(slot), method: :patch, title: t("yard.index.toggle", code: slot.code), aria: { label: t("yard.index.toggle", code: slot.code) },
        form: { data: { turbo_confirm: (slot.enabled ? t("yard.index.confirm_disable", code: slot.code) : nil) } },
        class: "flex min-h-12 cursor-pointer items-center gap-2 rounded-2xl px-4 text-sm font-medium transition-all duration-200 ease-out hover:opacity-80 active:scale-95 #{classes}" do %>
    <%= material_icon(slot.enabled ? "check_circle" : "block") %> <%= label %>
  <% end %>
<% else %>
  <span class="inline-flex min-h-8 items-center gap-1 rounded-lg px-3 text-sm font-medium <%= classes %>"><%= label %></span>
<% end %>
