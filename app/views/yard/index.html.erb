<div class="w-full">
  <div class="mb-6 flex items-center gap-3">
    <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600">
      <%= material_icon "grid_view" %>
    </span>
    <div>
      <h1 class="text-2xl font-bold text-slate-900 sm:text-3xl"><%= t(".title") %></h1>
      <p class="text-sm text-slate-500"><%= t(".subtitle") %></p>
    </div>
  </div>

  <section class="mb-6 overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-sm" aria-label="<%= t(".map") %>"
           data-controller="yard-map"
           data-yard-map-blocks-value="<%= @blocks.map { |block| { code: block.code, bays: block.bays, rows: block.rows, levels: block.levels } }.to_json %>"
           data-yard-map-sections-value="<%= @sections_map.to_json %>"
           data-yard-map-disabled-value="<%= @disabled_codes.to_json %>"
           data-yard-map-occupied-value="<%= @occupied_containers.to_json %>"
           data-yard-map-labels-value="<%= { hint: t(".map_hint"), enabled: t("yard.states.enabled"), disabled: t("yard.states.disabled"), occupied: t("yard.states.occupied"), container: Container.model_name.human, size: Container.human_attribute_name(:size), block: YardBlock.model_name.human, bay: YardSlot.human_attribute_name(:bay), row: YardSlot.human_attribute_name(:row), level: YardSlot.human_attribute_name(:level), desycon: t(".desycon"), section: YardAreaSection.model_name.human }.to_json %>">
    <div class="flex flex-wrap items-end justify-between gap-3 p-4">
      <div>
        <h2 class="flex items-center gap-2 text-lg font-bold text-slate-900"><%= material_icon "view_in_ar" %> <%= t(".map") %></h2>
        <p class="text-sm text-amber-700"><%= t(".map_provisional") %></p>
      </div>
      <div class="flex flex-wrap items-end gap-3">
        <div>
          <label for="yard-map-block" class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500"><%= YardBlock.model_name.human %></label>
          <select id="yard-map-block" data-yard-map-target="block" data-action="change->yard-map#filterBlock"
                  class="h-12 rounded-2xl border border-slate-200 bg-white px-4 text-sm focus:border-indigo-500 focus:outline-none">
            <option value=""><%= t("shared.filters.all") %></option>
            <% @blocks.each do |block| %><option value="<%= block.code %>"><%= block.code %></option><% end %>
          </select>
        </div>
        <div>
          <label for="yard-map-level" class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500"><%= YardSlot.human_attribute_name(:level) %></label>
          <select id="yard-map-level" data-yard-map-target="level" data-action="change->yard-map#filterLevel"
                  class="h-12 rounded-2xl border border-slate-200 bg-white px-4 text-sm focus:border-indigo-500 focus:outline-none">
            <option value=""><%= t("shared.filters.all") %></option>
            <% (1..@blocks.map(&:levels).max.to_i).each do |level| %><option value="<%= level %>"><%= level %></option><% end %>
          </select>
        </div>
        <button type="button" data-action="yard-map#resetView"
                class="flex min-h-12 cursor-pointer items-center gap-2 rounded-2xl border border-slate-200 px-4 font-medium text-slate-700 transition-all duration-200 ease-out hover:bg-slate-100 active:scale-95">
          <%= material_icon "center_focus_strong" %> <%= t(".reset_view") %>
        </button>
        <%= render "yard_areas/guide" %>
        <button type="button" data-yard-map-target="areasToggle" data-action="yard-map#toggleAreas" aria-pressed="false"
                class="flex min-h-12 cursor-pointer items-center gap-2 rounded-2xl border border-slate-200 px-4 font-medium text-slate-700 transition-all duration-200 ease-out hover:bg-slate-100 active:scale-95 aria-pressed:border-indigo-500 aria-pressed:bg-indigo-50 aria-pressed:text-indigo-700">
          <%= material_icon "layers" %> <%= t(".areas") %>
        </button>
      </div>
    </div>
    <div data-yard-map-target="canvas" class="h-[60vh] min-h-80 w-full touch-none"></div>
    <ul data-yard-map-target="legend" hidden class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-slate-100 p-4 text-sm text-slate-600">
      <% @sections_map.each do |section| %>
        <li class="flex items-center gap-2">
          <span class="h-3 w-3 rounded-sm" style="background-color: <%= section[:color] %>"></span>
          <%= section[:label] %><% if section[:detail].present? %> <span class="text-slate-400">(<%= section[:detail] %>)</span><% end %>
        </li>
      <% end %>
      <li class="flex items-center gap-2"><span class="h-3 w-3 rounded-sm bg-slate-300"></span><%= t(".unassigned") %></li>
      <% if @sections_map.empty? %><li class="text-slate-400"><%= t(".no_sections") %></li><% end %>
    </ul>
    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 p-4">
      <div data-yard-map-target="info" class="min-w-0"><p class="text-sm text-slate-500"><%= t(".map_hint") %></p></div>
      <ul class="flex flex-wrap items-center gap-4 text-sm text-slate-600">
        <li class="flex items-center gap-2"><span class="h-3 w-3 rounded-sm bg-indigo-500"></span><%= t("yard.states.enabled") %></li>
        <li class="flex items-center gap-2"><span class="h-3 w-6 rounded-sm bg-sky-800"></span><%= t(".occupied") %></li>
        <li class="flex items-center gap-2"><span class="h-3 w-3 rounded-sm bg-amber-500"></span><%= t("yard.states.disabled") %></li>
        <li class="flex items-center gap-2"><span class="h-3 w-3 rounded-sm bg-emerald-500"></span><%= t(".selected") %></li>
      </ul>
    </div>
  </section>

  <section class="mb-6" aria-label="<%= YardBlock.model_name.human(count: 2) %>">
    <h2 class="mb-3 text-lg font-bold text-slate-900"><%= YardBlock.model_name.human(count: 2) %></h2>
    <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3">
      <% @blocks.each do |block| %>
        <% enabled = @slot_counts.fetch([ block.id, true ], 0) %>
        <% disabled = @slot_counts.fetch([ block.id, false ], 0) %>
        <li class="rounded-3xl border border-slate-100 bg-white p-5 shadow-sm">
          <div class="flex items-center justify-between">
            <p class="text-xl font-bold text-slate-900"><%= block.code %></p>
            <span class="rounded-lg bg-indigo-50 px-3 py-1 text-sm font-medium text-indigo-700"><%= t(".slots", count: enabled + disabled) %></span>
          </div>
          <dl class="mt-3 grid grid-cols-3 gap-2 text-sm">
            <div><dt class="text-slate-500"><%= YardBlock.human_attribute_name(:bays) %></dt><dd class="font-medium text-slate-800"><%= block.bays %></dd></div>
            <div><dt class="text-slate-500"><%= YardBlock.human_attribute_name(:rows) %></dt><dd class="font-medium text-slate-800"><%= block.row_letters.first %>–<%= block.row_letters.last %></dd></div>
            <div><dt class="text-slate-500"><%= YardBlock.human_attribute_name(:levels) %></dt><dd class="font-medium text-slate-800"><%= block.levels %></dd></div>
          </dl>
          <% if disabled.positive? %>
            <p class="mt-3 text-sm text-amber-700"><%= t(".disabled_count", count: disabled) %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>

  <h2 class="mb-3 text-lg font-bold text-slate-900"><%= t(".positions") %></h2>
  <%= render "shared/filters" %>

  <ul class="space-y-3 md:hidden">
    <% @slots.each do |slot| %>
      <li class="flex items-center justify-between gap-3 rounded-3xl border border-slate-100 bg-white p-4 shadow-sm">
        <div>
          <p class="font-mono text-lg font-bold text-slate-900"><%= slot.code %></p>
          <p class="text-sm text-slate-500"><%= t(".position", block: slot.yard_block.code, bay: slot.bay, row: slot.row, level: slot.level) %></p>
        </div>
        <%= render "slot_state", slot: slot %>
      </li>
    <% end %>
  </ul>

  <div class="hidden overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-sm md:block">
    <table class="w-full text-left">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
        <tr>
          <th class="p-4"><%= YardSlot.human_attribute_name(:code) %></th>
          <th class="p-4"><%= YardBlock.model_name.human %></th>
          <th class="p-4"><%= YardSlot.human_attribute_name(:bay) %></th>
          <th class="p-4"><%= YardSlot.human_attribute_name(:row) %></th>
          <th class="p-4"><%= YardSlot.human_attribute_name(:level) %></th>
          <th class="p-4 text-right"><%= YardSlot.human_attribute_name(:enabled) %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @slots.each do |slot| %>
          <tr class="transition-colors hover:bg-slate-50">
            <td class="p-4 font-mono font-bold text-slate-900"><%= slot.code %></td>
            <td class="p-4 text-slate-700"><%= slot.yard_block.code %></td>
            <td class="p-4 text-slate-700"><%= slot.bay %></td>
            <td class="p-4 text-slate-700"><%= slot.row %></td>
            <td class="p-4 text-slate-700"><%= slot.level %></td>
            <td class="p-4"><div class="flex justify-end"><%= render "slot_state", slot: slot %></div></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "shared/pagination", pagy: @pagy %>
</div>
