<div class="w-full">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600"><%= material_icon "qr_code_2" %></span>
      <div>
        <h1 class="text-2xl font-bold text-slate-900 sm:text-3xl"><%= t(".title") %></h1>
        <p class="text-sm text-slate-500"><%= t(".count", count: @pagy.count) %></p>
      </div>
    </div>
    <% if policy(MovementPass).create? %>
      <%= link_to new_movement_pass_path, class: "flex min-h-12 w-full items-center justify-center gap-2 rounded-2xl bg-indigo-600 px-5 font-medium text-white transition-colors hover:bg-indigo-700 sm:w-auto" do %>
        <%= material_icon "add" %> <%= t(".new") %>
      <% end %>
    <% end %>
  </div>

  <%= render "shared/filters" %>

  <% if @passes.empty? %>
    <p class="rounded-3xl bg-slate-50 p-6 text-center text-slate-500"><%= t(".empty") %></p>
  <% end %>

  <ul class="space-y-3">
    <% @passes.each do |pass| %>
      <li>
        <%= link_to movement_pass_path(pass), class: "flex flex-wrap items-center justify-between gap-3 rounded-3xl border border-slate-100 bg-white p-4 shadow-sm transition-all duration-200 ease-out hover:shadow-md active:scale-[0.99]" do %>
          <div class="min-w-0">
            <% movement_styles = {
              "ingreso" => "bg-emerald-100 text-emerald-900",
              "salida" => "bg-amber-100 text-amber-950",
              "traspaleo" => "bg-indigo-100 text-indigo-900"
            } %>
            <% movement_icons = { "ingreso" => "move_to_inbox", "salida" => "logout", "traspaleo" => "swap_horiz" } %>
            <span data-movement-type="<%= pass.movement_type %>"
                  class="inline-flex min-h-9 items-center gap-2 rounded-full px-4 text-sm font-bold <%= movement_styles.fetch(pass.movement_type) %>">
              <%= material_icon movement_icons.fetch(pass.movement_type) %>
              <%= t("movement_passes.types.#{pass.movement_type}") %>
            </span>
            <p class="font-mono text-lg font-semibold text-slate-900"><%= pass.container.number %></p>
            <p class="text-sm text-slate-600">
              <% if pass.container.master_bl %>· <%= pass.container.master_bl.number %><% end %>
              <% if policy(pass).view_client? && pass.client %>· <%= pass.client.name %><% end %>
            </p>
            <p class="text-sm text-slate-500">
              <%= t(pass.entered_at? ? "movement_passes.show.entered_at" : ".expires") %>:
              <%= l(pass.entered_at || pass.expires_at, format: :short) %>
              <% if (vehicle = pass.vehicle("principal")) %>· <%= vehicle.plate %><% end %>
            </p>
          </div>
          <%= render "movement_passes/status", pass: pass %>
        <% end %>
      </li>
    <% end %>
  </ul>
  <%= render "shared/pagination", pagy: @pagy %>
</div>
