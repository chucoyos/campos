<% status = pass.display_status %>
<span class="rounded-full px-3 py-1 text-xs font-medium <%= { "vigente" => "bg-emerald-100 text-emerald-800", "completado" => "bg-sky-100 text-sky-800", "cancelado" => "bg-slate-100 text-slate-600", "vencido" => "bg-amber-100 text-amber-800" }[status] %>">
  <%= t("movement_passes.statuses.#{status}") %>
</span>
