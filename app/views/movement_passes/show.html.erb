<div class="mx-auto w-full max-w-3xl">
  <%= link_to movement_passes_path, class: "mb-4 inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-800" do %>
    <%= material_icon "arrow_back" %> <%= t("shared.actions.back") %>
  <% end %>

  <div class="space-y-6 rounded-3xl border border-slate-100 bg-white p-8 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="text-sm font-medium uppercase tracking-wide text-indigo-600"><%= t("movement_passes.types.#{@pass.movement_type}") %></p>
        <h1 class="font-mono text-3xl font-bold text-slate-900"><%= @pass.container.number %></h1>
        <p class="text-sm text-slate-500">
          <%= @pass.container.size %>'
          <% if @pass.container.master_bl %>· <%= @pass.container.master_bl.number %><% end %>
          <% if policy(@pass).view_client? && @pass.client %>· <%= @pass.client.name %><% end %>
        </p>
      </div>
      <%= render "movement_passes/status", pass: @pass %>
    </div>

    <% if @pass.usable? %>
      <div class="flex flex-col items-center gap-3 rounded-2xl bg-slate-50 p-6">
        <div class="rounded-2xl bg-white p-3 shadow-sm [&_svg]:h-56 [&_svg]:w-56">
          <%= image_tag "data:image/svg+xml;base64,#{Base64.strict_encode64(RQRCode::QRCode.new(@gate_url, level: :m).as_svg(module_size: 4, viewbox: true, use_path: true))}", alt: t(".qr_alt"), class: "h-56 w-56" %>
        </div>
        <p class="break-all text-center font-mono text-xs text-slate-500"><%= @pass.token %></p>
        <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row">
          <%= link_to movement_pass_path(@pass, format: :pdf), target: "_blank", rel: "noopener", class: "flex min-h-12 items-center justify-center gap-2 rounded-2xl bg-indigo-600 px-5 font-medium text-white transition-all duration-200 ease-out hover:bg-indigo-700 active:scale-95" do %>
            <%= material_icon "picture_as_pdf" %> <%= t(".download") %>
          <% end %>
          <% if policy(@pass).cancel? %>
            <%= button_to cancel_movement_pass_path(@pass), method: :patch, form: { data: { turbo_confirm: t(".confirm_cancel") } },
                  class: "flex min-h-12 w-full cursor-pointer items-center justify-center gap-2 rounded-2xl px-5 font-medium text-red-600 transition-all duration-200 ease-out hover:bg-red-50 active:scale-95" do %>
              <%= material_icon "cancel" %> <%= t(".cancel") %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <dl class="grid gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-sm text-slate-500"><%= t("movement_passes.pdf.issued_at") %></dt>
        <dd class="font-medium"><%= l(@pass.issued_at, format: :long) %></dd>
      </div>
      <% if @pass.entered_at? %>
        <div>
          <dt class="text-sm text-slate-500"><%= t(".entered_at") %></dt>
          <dd class="font-medium"><%= l(@pass.entered_at, format: :long) %></dd>
        </div>
        <% if @pass.exit_scanned_at? %>
          <div>
            <dt class="text-sm text-slate-500"><%= t(".exit_scanned_at") %></dt>
            <dd class="font-medium"><%= l(@pass.exit_scanned_at, format: :long) %></dd>
          </div>
        <% end %>
      <% else %>
        <div>
          <dt class="text-sm text-slate-500"><%= t("movement_passes.pdf.expires_at") %></dt>
          <dd class="font-medium"><%= l(@pass.expires_at, format: :long) %></dd>
        </div>
      <% end %>
      <% if @pass.consumed_at %>
        <div>
          <dt class="text-sm text-slate-500"><%= MovementPass.human_attribute_name(:consumed_at) %></dt>
          <dd class="font-medium"><%= l(@pass.consumed_at, format: :long) %></dd>
        </div>
      <% end %>
      <% if @pass.load_status %>
        <div>
          <dt class="text-sm text-slate-500"><%= MovementPass.human_attribute_name(:load_status) %></dt>
          <dd class="font-medium"><%= t("movement_passes.load_statuses.#{@pass.load_status}") %></dd>
        </div>
      <% end %>
    </dl>

    <% @pass.vehicles.sort_by(&:role).each do |vehicle| %>
      <section class="rounded-2xl border border-slate-200 p-4">
        <h2 class="mb-2 flex items-center gap-2 font-semibold text-slate-900"><%= material_icon "local_shipping", classes: "text-indigo-600" %> <%= t("movement_passes.pdf.vehicle_#{vehicle.role}") %></h2>
        <dl class="grid gap-2 text-sm sm:grid-cols-2">
          <% %i[company_name operator_name plate unit_type].each do |attribute| %>
            <div>
              <dt class="text-slate-500"><%= MovementPassVehicle.human_attribute_name(attribute) %></dt>
              <dd class="font-medium"><%= attribute == :unit_type ? t("movement_passes.unit_types.#{vehicle.unit_type}") : vehicle.public_send(attribute) %></dd>
            </div>
          <% end %>
        </dl>
      </section>
    <% end %>
  </div>
</div>
