<%# Menú de tres puntos reutilizable. items: [{ label:, icon:, href:, method: (opcional), confirm: (opcional), tone: :danger (opcional) }]. Los items nil se omiten. %>
<% items = items.compact %>
<% if items.any? %>
  <div class="relative" data-controller="row-actions">
    <button type="button" data-row-actions-target="button" data-action="row-actions#toggle" aria-expanded="false" aria-haspopup="menu"
            title="<%= t("shared.actions.title") %>" aria-label="<%= local_assigns[:label] || t("shared.actions.title") %>"
            class="flex h-12 w-12 cursor-pointer items-center justify-center rounded-full text-slate-600 transition-all duration-200 ease-out hover:bg-slate-100 active:scale-95">
      <%= material_icon "more_vert" %>
    </button>
    <div data-row-actions-target="menu" role="menu" class="fixed z-50 hidden min-w-48 rounded-2xl border border-slate-200/60 bg-white p-2 shadow-md">
      <% items.each do |item| %>
        <% tone = item[:tone] == :danger ? "text-red-600 hover:bg-red-50" : "text-slate-700 hover:bg-slate-100" %>
        <% css = "flex min-h-12 w-full cursor-pointer items-center gap-3 rounded-xl px-3 text-left text-sm font-medium transition-colors #{tone}" %>
        <% if item[:method] %>
          <%= button_to item[:href], method: item[:method], role: "menuitem", class: css,
                form: { class: "w-full", data: ({ turbo_confirm: item[:confirm] } if item[:confirm]) } do %>
            <%= material_icon item[:icon] %> <%= item[:label] %>
          <% end %>
        <% else %>
          <%= link_to item[:href], role: "menuitem", class: css do %>
            <%= material_icon item[:icon] %> <%= item[:label] %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
