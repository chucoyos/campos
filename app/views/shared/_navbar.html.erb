<%
  items = {
    master_bls: [t(".master_bls"), master_bls_path, "description", controller_name == "master_bls", policy(MasterBl).index?],
    cargo_manifests: [t(".cargo_manifests"), cargo_manifests_path, "package_2", controller_name.in?(%w[cargo_manifests cargo_items]), policy(CargoManifest).index?],
    warehouse: [t(".warehouse"), warehouse_path, "warehouse", controller_name.in?(%w[warehouse warehouse_slots]), policy(WarehouseSlot).index?],
    containers: [t(".containers"), containers_path, "inventory_2", controller_name == "containers", policy(Container).index?],
    yard: [t(".yard"), yard_path, "grid_view", controller_name == "yard", policy(YardSlot).index?],
    yard_areas: [t(".yard_areas"), yard_areas_path, "map", controller_name.in?(%w[yard_areas yard_area_sections]), policy(YardArea).index?],
    container_assignments: [t(".container_assignments"), container_assignments_path, "assignment", controller_name == "container_assignments", policy(ContainerAssignment).index?],
    movement_passes: [t(".movement_passes"), movement_passes_path, "qr_code_2", controller_name == "movement_passes", policy(MovementPass).index?],
    gate: [t(".gate"), gate_path, "qr_code_scanner", controller_name == "gate", policy(MovementPass).gate?],
    crane: [t(".crane"), crane_path, "precision_manufacturing", controller_name == "crane", policy(WorkOrder).index?],
    clients: [t(".clients"), clients_path, "person_search", controller_name == "clients", policy(Client).index?],
    carriers: [t(".carriers"), carriers_path, "local_shipping", controller_name == "carriers", policy(Carrier).index?],
    users: [t(".users"), users_path, "group", controller_name == "users", policy(User).index?],
    cargo_packagings: [t(".cargo_packagings"), cargo_packagings_path, "category", controller_name == "cargo_packagings", policy(CargoPackaging).index?]
  }
  group_defs = [
    [t(".groups.deconsolidation"), "directions_boat", %i[master_bls cargo_manifests warehouse]],
    [t(".groups.yard"), "grid_view", %i[containers yard yard_areas]],
    [t(".groups.movements"), "swap_horiz", %i[container_assignments movement_passes gate crane]],
    [t(".catalogs"), "folder_open", %i[clients carriers users cargo_packagings]]
  ]
  # Los grupos con un solo enlace visible se muestran como enlace directo.
  nav = group_defs.flat_map do |label, icon, keys|
    visible = items.values_at(*keys).select(&:last).map { |item| item[0..3] }
    if visible.size > 1
      [{ label: label, icon: icon, items: visible, active: visible.any? { |*, active| active } }]
    else
      visible.map { |item| { link: item } }
    end
  end
%>

<header class="sticky top-0 z-10 px-3 pt-3 sm:px-5" data-controller="navbar">
  <nav class="container mx-auto rounded-3xl border border-slate-200/60 bg-gradient-to-b from-slate-100/80 via-white/80 to-slate-200/80 px-3 py-2 shadow-sm backdrop-blur-md" aria-label="<%= t(".main_navigation") %>">
    <div class="flex items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <%= link_to root_path, class: "mr-1 flex min-h-12 items-center gap-2 rounded-2xl px-3 text-lg font-bold text-slate-900 md:mr-3" do %>
          <%= image_tag "logo.svg", alt: "", class: "h-9 w-9" %>
          Campos
        <% end %>

        <div class="hidden items-center gap-2 md:flex">
          <% nav.each do |entry| %>
            <% if entry[:link] %>
              <% label, path, icon, active = entry[:link] %>
              <%= link_to path, class: nav_link_classes(active), aria: { current: (active ? "page" : nil) } do %>
                <%= material_icon icon %> <%= label %>
              <% end %>
            <% else %>
              <div class="relative" data-controller="dropdown">
                <button type="button" data-dropdown-target="button" data-action="dropdown#toggle" aria-expanded="false" aria-haspopup="true"
                        class="<%= nav_link_classes(entry[:active]) %> cursor-pointer">
                  <%= material_icon entry[:icon] %> <%= entry[:label] %> <%= material_icon "expand_more" %>
                </button>
                <div data-dropdown-target="menu" class="absolute left-0 top-full z-20 mt-2 hidden w-56 space-y-1 rounded-2xl border border-slate-200/60 bg-white p-2 shadow-md">
                  <% entry[:items].each do |label, path, icon, active| %>
                    <%= link_to path, class: "#{nav_link_classes(active)} w-full", aria: { current: (active ? "page" : nil) } do %>
                      <%= material_icon icon %> <%= label %>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <div class="hidden items-center gap-3 rounded-2xl bg-white/60 py-1.5 pl-2 pr-4 lg:flex">
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-indigo-100 text-indigo-700">
            <%= material_icon "person" %>
          </span>
          <div class="leading-tight">
            <p class="text-sm font-medium text-slate-800"><%= current_user.email %></p>
            <p class="text-xs text-slate-500"><%= current_user.role.humanize %></p>
          </div>
        </div>

        <button type="button" data-navbar-target="button" data-action="navbar#toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="<%= t(".open_menu") %>"
                class="flex h-12 w-12 cursor-pointer items-center justify-center rounded-2xl text-slate-600 transition-colors hover:bg-slate-100 md:hidden">
          <span data-navbar-target="openIcon"><%= material_icon "menu" %></span>
          <span data-navbar-target="closeIcon" class="hidden"><%= material_icon "close" %></span>
        </button>

        <%= button_to destroy_user_session_path, method: :delete, title: t(".sign_out"), aria: { label: t(".sign_out") },
              form_class: "hidden md:block",
              class: "flex h-12 w-12 cursor-pointer items-center justify-center rounded-2xl text-slate-600 transition-colors hover:bg-red-50 hover:text-red-600" do %>
          <%= material_icon "logout" %>
        <% end %>
      </div>
    </div>

    <div id="mobile-menu" data-navbar-target="menu" class="hidden space-y-1 border-t border-slate-200/60 pt-2 mt-2 md:hidden">
      <% nav.each do |entry| %>
        <% if entry[:link] %>
          <% label, path, icon, active = entry[:link] %>
          <%= link_to path, class: "#{nav_link_classes(active)} w-full", aria: { current: (active ? "page" : nil) } do %>
            <%= material_icon icon %> <%= label %>
          <% end %>
        <% else %>
          <details class="group" <%= "open" if entry[:active] %>>
            <summary class="<%= nav_link_classes(entry[:active]) %> w-full cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <%= material_icon entry[:icon] %> <%= entry[:label] %>
              <%= material_icon "expand_more", classes: "ml-auto transition-transform duration-200 group-open:rotate-180" %>
            </summary>
            <div class="mt-1 space-y-1 pl-4">
              <% entry[:items].each do |label, path, icon, active| %>
                <%= link_to path, class: "#{nav_link_classes(active)} w-full", aria: { current: (active ? "page" : nil) } do %>
                  <%= material_icon icon %> <%= label %>
                <% end %>
              <% end %>
            </div>
          </details>
        <% end %>
      <% end %>
      <div class="flex items-center gap-3 rounded-2xl bg-white/60 p-3">
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-indigo-100 text-indigo-700">
          <%= material_icon "person" %>
        </span>
        <div class="min-w-0 leading-tight">
          <p class="truncate text-sm font-medium text-slate-800"><%= current_user.email %></p>
          <p class="text-xs text-slate-500"><%= current_user.role.humanize %></p>
        </div>
      </div>
      <%= button_to destroy_user_session_path, method: :delete, form_class: "w-full",
            class: "flex min-h-12 w-full cursor-pointer items-center gap-2 rounded-2xl px-4 text-sm font-medium text-red-600 transition-colors hover:bg-red-50" do %>
        <%= material_icon "logout" %> <%= t(".sign_out") %>
      <% end %>
    </div>
  </nav>
</header>
