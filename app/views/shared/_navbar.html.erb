<header class="sticky top-0 z-10 px-3 pt-3 sm:px-5">
  <nav class="container mx-auto flex items-center justify-between gap-3 rounded-3xl border border-slate-100 bg-white px-3 py-2 shadow-sm" aria-label="Navegación principal">
    <div class="flex items-center gap-1 sm:gap-2">
      <%= link_to root_path, class: "mr-1 flex min-h-12 items-center gap-2 rounded-2xl px-3 text-lg font-bold text-slate-900 sm:mr-3" do %>
        <span class="flex h-9 w-9 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600">
          <%= material_icon "local_shipping" %>
        </span>
        <span class="hidden sm:inline">Soluciones Campos</span>
      <% end %>

      <%= link_to root_path, class: nav_link_classes(current_page?(root_path)), aria: { current: (current_page?(root_path) ? "page" : nil) } do %>
        <%= material_icon "home" %>
        <span class="hidden md:inline">Inicio</span>
      <% end %>

      <% if policy(User).index? %>
        <%= link_to users_path, class: nav_link_classes(controller_name == "users"), aria: { current: (controller_name == "users" ? "page" : nil) } do %>
          <%= material_icon "group" %>
          <span class="hidden md:inline">Usuarios</span>
        <% end %>
      <% end %>
    </div>

    <div class="flex items-center gap-2">
      <div class="hidden items-center gap-3 rounded-2xl bg-slate-50 py-1.5 pl-2 pr-4 lg:flex">
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-indigo-100 text-indigo-700">
          <%= material_icon "person" %>
        </span>
        <div class="leading-tight">
          <p class="text-sm font-medium text-slate-800"><%= current_user.email %></p>
          <p class="text-xs text-slate-500"><%= current_user.role.humanize %></p>
        </div>
      </div>

      <%= button_to destroy_user_session_path, method: :delete, title: "Cerrar sesión", aria: { label: "Cerrar sesión" },
            class: "flex h-12 w-12 cursor-pointer items-center justify-center rounded-2xl text-slate-600 transition-colors hover:bg-red-50 hover:text-red-600" do %>
        <%= material_icon "logout" %>
      <% end %>
    </div>
  </nav>
</header>
