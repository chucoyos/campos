<%# Usuarios vinculados a un Client o Carrier, con alta, vinculación y baja. %>
<section class="mt-6 rounded-3xl border border-slate-100 bg-white p-6 shadow-sm">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <h2 class="flex items-center gap-2 text-lg font-semibold text-slate-900">
      <%= material_icon "group", classes: "text-indigo-600" %> <%= t("shared.related_users.title") %>
      <span class="rounded-lg bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700"><%= users.size %></span>
    </h2>
    <%= link_to new_path, class: "flex min-h-12 items-center gap-2 rounded-full bg-indigo-600 px-5 font-medium text-white shadow-sm transition-all duration-200 ease-out hover:bg-indigo-700 active:scale-95" do %>
      <%= material_icon "person_add" %> <%= t("shared.related_users.new_user") %>
    <% end %>
  </div>

  <% if users.empty? %>
    <p class="text-sm text-slate-500"><%= t("shared.related_users.empty") %></p>
  <% else %>
    <ul class="divide-y divide-slate-100">
      <% users.each do |user| %>
        <li class="flex flex-wrap items-center justify-between gap-3 py-3">
          <div class="min-w-0">
            <p class="truncate font-medium text-slate-800"><%= user.email %></p>
            <%= role_badge(user.role) %>
          </div>
          <div class="flex items-center gap-1">
            <%= link_to user_path(user), title: t("shared.related_users.manage"), aria: { label: t("shared.related_users.manage") },
                  class: "flex h-12 w-12 items-center justify-center rounded-full text-slate-600 transition-all duration-200 ease-out hover:bg-slate-100 active:scale-95" do %>
              <%= material_icon "manage_accounts" %>
            <% end %>
            <%= link_to edit_user_path(user), title: t("users.actions.edit"), aria: { label: t("users.actions.edit_user", email: user.email) },
                  class: "flex h-12 w-12 items-center justify-center rounded-full text-slate-600 transition-all duration-200 ease-out hover:bg-slate-100 active:scale-95" do %>
              <%= material_icon "edit" %>
            <% end %>
            <%= button_to unlink_path.call(user), method: :delete,
                  form: { data: { turbo_confirm: t("shared.related_users.confirm_unlink", email: user.email) } },
                  title: t("shared.related_users.unlink"), aria: { label: t("shared.related_users.unlink") },
                  class: "flex h-12 w-12 cursor-pointer items-center justify-center rounded-full text-red-600 transition-all duration-200 ease-out hover:bg-red-50 active:scale-95" do %>
              <%= material_icon "link_off" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if linkable_users.any? %>
    <%= form_with url: link_path, method: :post, class: "mt-4 flex flex-wrap items-center gap-3 rounded-2xl bg-slate-50 p-3" do |f| %>
      <%= f.label :user_id, t("shared.related_users.link_prompt"), class: "sr-only" %>
      <%= f.collection_select :user_id, linkable_users, :id, :email, { prompt: t("shared.related_users.link_prompt") },
            class: "min-h-12 flex-1 rounded-2xl border border-slate-200 bg-white p-3 focus:border-indigo-500 focus:outline-none" %>
      <%= f.button class: "flex min-h-12 cursor-pointer items-center gap-2 rounded-2xl bg-indigo-50 px-4 font-medium text-indigo-700 transition-all duration-200 ease-out hover:bg-indigo-100 active:scale-95" do %>
        <%= material_icon "link" %> <%= t("shared.related_users.link") %>
      <% end %>
    <% end %>
  <% end %>
</section>
