<% input = "min-h-12 w-full rounded-lg border border-slate-300 bg-white px-3" %>
<div class="space-y-3">
  <div>
    <%= label_tag "instruction_criterion", t("cargo_dispatch.ui.criterion"), class: "text-sm font-medium" %>
    <%= select_tag "instruction[criterion]", options_for_select(%w[quantity weight].map { |value| [ t("cargo_dispatch.ui.criteria.#{value}"), value ] }, params.dig(:instruction, :criterion) || "quantity"),
          class: input, data: { cargo_dispatch_request_target: "criterion", action: "change->cargo-dispatch-request#toggleCriterion" } %>
  </div>
  <div data-cargo-dispatch-request-target="quantity">
    <%= label_tag "instruction_cargo_packaging_id", t("cargo_dispatch.ui.packaging"), class: "text-sm font-medium" %>
    <%= select_tag "instruction[cargo_packaging_id]", options_from_collection_for_select(packagings, :id, :name), include_blank: t("cargo_dispatch.ui.unspecified"), class: input %>
    <%= label_tag "instruction_quantity", t("cargo_dispatch.ui.quantity"), class: "mt-3 block text-sm font-medium" %>
    <%= number_field_tag "instruction[quantity]", nil, min: 1, step: 1, required: true, class: input, data: { cargo_dispatch_request_target: "quantityInput" } %>
  </div>
  <div data-cargo-dispatch-request-target="weight" hidden>
    <%= label_tag "instruction_weight_kg", t("cargo_dispatch.ui.weight"), class: "text-sm font-medium" %>
    <%= number_field_tag "instruction[weight_kg]", nil, min: 0.001, step: 0.001, required: true, class: input, data: { cargo_dispatch_request_target: "weightInput" } %>
  </div>
  <fieldset>
    <legend class="text-sm font-medium"><%= t("cargo_dispatch.ui.preferred_containers") %></legend>
    <% if containers.any? %>
      <div class="mt-2 grid gap-2 sm:grid-cols-2">
        <% selected_container_ids = Array(params.dig(:instruction, :preferred_container_ids)).map(&:to_s) %>
        <% containers.each do |container| %>
          <label data-cargo-dispatch-request-target="preferredContainerOption"
                 class="flex min-h-12 cursor-pointer items-center gap-3 rounded-2xl border border-slate-200 bg-white p-3 text-sm text-slate-700 transition-all duration-200 ease-out hover:bg-sky-50 has-[:checked]:border-sky-700 has-[:checked]:bg-sky-50 has-[:checked]:text-sky-900">
            <%= check_box_tag "instruction[preferred_container_ids][]", container.id, selected_container_ids.include?(container.id.to_s),
                  class: "h-5 w-5 rounded border-slate-400 text-sky-800 focus:ring-sky-700",
                  data: { client_id: container.master_bl.client_id, cargo_dispatch_request_target: "preferredContainer" } %>
            <span class="min-w-0"><span class="block truncate font-medium"><%= container.number %></span>
              <span class="block truncate text-xs text-slate-500"><%= container.master_bl.number %></span></span>
            <%= material_icon "directions_boat", classes: "ml-auto text-sky-800" %>
          </label>
        <% end %>
      </div>
    <% else %>
      <p class="mt-2 rounded-2xl bg-slate-50 p-3 text-sm text-slate-600"><%= t("cargo_dispatch.ui.no_containers") %></p>
    <% end %>
    <p class="mt-1 text-xs text-slate-500"><%= t("cargo_dispatch.ui.preferred_containers_hint") %></p>
  </fieldset>
  <p class="text-sm text-slate-600"><%= t("cargo_dispatch.ui.instruction_hint") %></p>
</div>
