<div class="mx-auto max-w-3xl space-y-5">
  <header class="rounded-3xl bg-slate-900 p-6 text-white shadow-sm sm:p-8">
    <div class="flex items-start gap-4">
      <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-sky-800 text-sky-100"><%= material_icon "local_shipping", classes: "!text-3xl" %></span>
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-sky-200"><%= t("cargo_dispatch.ui.request_eyebrow") %></p>
        <h1 class="mt-1 text-2xl font-bold sm:text-3xl"><%= t("cargo_dispatch.ui.new_request") %></h1>
        <p class="mt-2 text-sm text-slate-200"><%= t("cargo_dispatch.ui.request_intro") %></p>
      </div>
    </div>
  </header>

  <div class="flex justify-end">
    <%= render "cargo_dispatch_requests/guide" %>
  </div>

  <%= render "availability", availability: @availability if @availability %>
  <%= form_with model: @request, data: { controller: "cargo-dispatch-request" },
        class: "space-y-5 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7" do |f| %>
    <% if @request.errors.any? %><div role="alert" class="rounded-2xl bg-red-50 p-4 text-red-700"><%= @request.errors.full_messages.to_sentence %></div><% end %>
    <section class="space-y-3">
      <h2 class="flex items-center gap-2 text-lg font-semibold text-slate-900"><%= material_icon "assignment" %> <%= t("cargo_dispatch.ui.request_details") %></h2>
      <% if @clients %>
        <div>
          <%= f.label :client_id, Client.model_name.human, class: "mb-1 block text-sm font-medium text-slate-700" %>
          <%= f.collection_select :client_id, @clients, :id, :name, { prompt: t("cargo_dispatch.ui.choose"), selected: @selected_client_id },
                class: "min-h-12 w-full rounded-lg border border-slate-300 px-3",
                required: true, data: { cargo_dispatch_request_target: "client", action: "change->cargo-dispatch-request#filterContainers" } %>
        </div>
      <% end %>
      <div>
        <%= f.label :destination, t("cargo_dispatch.ui.destination"), class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.text_field :destination, required: true, class: "min-h-12 w-full rounded-lg border border-slate-300 px-3" %>
      </div>
    </section>
    <section class="space-y-3 border-t border-slate-200 pt-5">
      <h2 class="flex items-center gap-2 text-lg font-semibold text-slate-900"><%= material_icon "inventory_2" %> <%= t("cargo_dispatch.ui.instructions") %></h2>
      <%= render "instruction_fields", containers: @containers, packagings: @packagings %>
    </section>
    <%= f.button class: "flex min-h-12 w-full items-center justify-center gap-2 rounded-full bg-indigo-700 px-6 font-semibold text-white transition-all duration-200 ease-out hover:bg-indigo-800 active:scale-95 sm:w-auto" do %>
      <%= material_icon "send" %> <%= t("cargo_dispatch.ui.create_request") %>
    <% end %>
  <% end %>
</div>
