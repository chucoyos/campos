<% input = "w-full rounded-2xl border border-slate-200 bg-white p-3 focus:border-indigo-500 focus:outline-none" %>
<% label = "mb-1 block text-sm font-medium text-slate-700" %>

<%= form_with model: user, class: "space-y-5" do |f| %>
  <% if user.errors.any? %>
    <div class="flex gap-3 rounded-2xl bg-red-50 p-4 text-sm text-red-700" role="alert">
      <%= material_icon "error" %>
      <ul>
        <% user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :email, "Correo electrónico", class: label %>
    <%= f.email_field :email, autocomplete: "off", class: input %>
  </div>

  <div>
    <%= f.label :role, "Rol", class: label %>
    <%= f.select :role, User::ROLES.map { |r| [r.humanize, r] }, { prompt: "Selecciona un rol" }, class: input %>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= f.label :password, "Contraseña", class: label %>
      <%= f.password_field :password, autocomplete: "new-password", class: input %>
    </div>
    <div>
      <%= f.label :password_confirmation, "Confirmar contraseña", class: label %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: input %>
    </div>
  </div>
  <% if user.persisted? %>
    <p class="-mt-3 text-xs text-slate-500">Déjala en blanco para conservar la contraseña actual.</p>
  <% end %>

  <div class="flex flex-wrap items-center gap-3 pt-2">
    <%= f.button class: "flex min-h-12 cursor-pointer items-center gap-2 rounded-2xl bg-indigo-600 px-5 font-medium text-white transition-colors hover:bg-indigo-700" do %>
      <%= material_icon "save" %> <%= user.persisted? ? "Guardar cambios" : "Crear usuario" %>
    <% end %>
    <%= link_to users_path, class: "flex min-h-12 items-center gap-2 rounded-2xl px-5 font-medium text-slate-600 transition-colors hover:bg-slate-100" do %>
      <%= material_icon "close" %> Cancelar
    <% end %>
  </div>
<% end %>
