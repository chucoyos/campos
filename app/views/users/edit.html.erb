<div class="mx-auto w-full max-w-2xl">
  <%= link_to users_path, class: "mb-4 inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-800" do %>
    <%= material_icon "arrow_back" %> Volver a usuarios
  <% end %>

  <div class="rounded-3xl border border-slate-100 bg-white p-8 shadow-sm">
    <div class="mb-6 flex items-center gap-3">
      <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600">
        <%= material_icon "edit" %>
      </span>
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Editar usuario</h1>
        <p class="text-sm text-slate-500"><%= @user.email %></p>
      </div>
    </div>

    <%= render "form", user: @user %>

    <% if policy(@user).destroy? %>
      <div class="mt-8 flex items-center justify-between gap-3 rounded-2xl border border-red-100 bg-red-50/50 p-4">
        <p class="text-sm text-slate-600">Eliminar este usuario es permanente.</p>
        <%= button_to user_path(@user), method: :delete,
              form: { data: { turbo_confirm: "¿Eliminar a #{@user.email}? Esta acción no se puede deshacer." } },
              class: "flex min-h-12 cursor-pointer items-center gap-2 rounded-2xl px-5 font-medium text-red-600 transition-colors hover:bg-red-100" do %>
          <%= material_icon "delete" %> Eliminar
        <% end %>
      </div>
    <% end %>
  </div>
</div>
