<div class="mx-auto w-full max-w-2xl">
  <%= link_to users_path, class: "mb-4 inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-800" do %>
    <%= material_icon "arrow_back" %> Volver a usuarios
  <% end %>

  <div class="rounded-3xl border border-slate-100 bg-white p-8 shadow-sm">
    <div class="mb-6 flex items-center gap-4">
      <span class="flex h-14 w-14 items-center justify-center rounded-full bg-slate-100 text-slate-600">
        <%= material_icon "person", classes: "!text-3xl" %>
      </span>
      <div>
        <h1 class="text-2xl font-bold text-slate-900"><%= @user.email %></h1>
        <%= role_badge(@user.role) %>
      </div>
    </div>

    <dl class="grid gap-4 rounded-2xl bg-slate-50 p-4 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-slate-500">Creado</dt>
        <dd class="font-medium text-slate-800"><%= l(@user.created_at, format: :long) %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Última actualización</dt>
        <dd class="font-medium text-slate-800"><%= l(@user.updated_at, format: :long) %></dd>
      </div>
    </dl>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <%= link_to edit_user_path(@user), class: "flex min-h-12 items-center gap-2 rounded-2xl bg-indigo-600 px-5 font-medium text-white transition-colors hover:bg-indigo-700" do %>
        <%= material_icon "edit" %> Editar
      <% end %>
      <% if policy(@user).destroy? %>
        <%= button_to user_path(@user), method: :delete,
              form: { data: { turbo_confirm: "¿Eliminar a #{@user.email}? Esta acción no se puede deshacer." } },
              class: "flex min-h-12 cursor-pointer items-center gap-2 rounded-2xl px-5 font-medium text-red-600 transition-colors hover:bg-red-50" do %>
          <%= material_icon "delete" %> Eliminar
        <% end %>
      <% end %>
    </div>
  </div>
</div>
