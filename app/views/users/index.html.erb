<div class="w-full">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 sm:text-3xl">Usuarios</h1>
      <p class="text-sm text-slate-500"><%= pluralize(@users.size, "usuario") %></p>
    </div>
    <%= link_to new_user_path, class: "flex min-h-12 w-full items-center justify-center gap-2 rounded-2xl bg-indigo-600 px-5 font-medium text-white transition-colors hover:bg-indigo-700 sm:w-auto" do %>
      <%= material_icon "person_add" %> Nuevo usuario
    <% end %>
  </div>

  <%# Tarjetas en pantallas pequeñas %>
  <ul class="space-y-3 md:hidden">
    <% @users.each do |user| %>
      <li class="rounded-3xl border border-slate-100 bg-white p-4 shadow-sm">
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-600">
            <%= material_icon "person" %>
          </span>
          <div class="min-w-0">
            <p class="truncate font-medium text-slate-800"><%= user.email %></p>
            <%= role_badge(user.role) %>
          </div>
        </div>
        <div class="mt-3 flex items-center justify-end gap-1 border-t border-slate-100 pt-3">
          <%= render "actions", user: user %>
        </div>
      </li>
    <% end %>
  </ul>

  <%# Tabla desde pantallas medianas %>
  <div class="hidden overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-sm md:block">
    <table class="w-full text-left">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
        <tr>
          <th class="p-4">Usuario</th>
          <th class="p-4">Rol</th>
          <th class="p-4 text-right">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @users.each do |user| %>
          <tr class="transition-colors hover:bg-slate-50">
            <td class="p-4">
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-slate-600">
                  <%= material_icon "person" %>
                </span>
                <span class="font-medium text-slate-800"><%= user.email %></span>
              </div>
            </td>
            <td class="p-4"><%= role_badge(user.role) %></td>
            <td class="p-4">
              <div class="flex items-center justify-end gap-1">
                <%= render "actions", user: user %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
