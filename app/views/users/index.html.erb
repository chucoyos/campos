<div class="w-full">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-3xl font-bold text-slate-900">Usuarios</h1>
      <p class="text-sm text-slate-500"><%= pluralize(@users.size, "usuario") %></p>
    </div>
    <%= link_to new_user_path, class: "flex min-h-12 items-center gap-2 rounded-2xl bg-indigo-600 px-5 font-medium text-white transition-colors hover:bg-indigo-700" do %>
      <%= material_icon "person_add" %> Nuevo usuario
    <% end %>
  </div>

  <div class="overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-sm">
    <table class="w-full text-left">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
        <tr>
          <th class="p-4">Usuario</th>
          <th class="p-4">Rol</th>
          <th class="p-4 text-right">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @users.each do |user| %>
          <tr class="transition-colors hover:bg-slate-50">
            <td class="p-4">
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-slate-600">
                  <%= material_icon "person" %>
                </span>
                <span class="font-medium text-slate-800"><%= user.email %></span>
              </div>
            </td>
            <td class="p-4"><%= role_badge(user.role) %></td>
            <td class="p-4">
              <div class="flex items-center justify-end gap-1">
                <%= link_to user_path(user), title: "Ver", aria: { label: "Ver #{user.email}" },
                      class: "flex h-12 w-12 items-center justify-center rounded-2xl text-slate-600 transition-colors hover:bg-sky-50 hover:text-sky-600" do %>
                  <%= material_icon "visibility" %>
                <% end %>
                <%= link_to edit_user_path(user), title: "Editar", aria: { label: "Editar #{user.email}" },
                      class: "flex h-12 w-12 items-center justify-center rounded-2xl text-slate-600 transition-colors hover:bg-indigo-50 hover:text-indigo-600" do %>
                  <%= material_icon "edit" %>
                <% end %>
                <% if policy(user).destroy? %>
                  <%= button_to user_path(user), method: :delete, title: "Eliminar", aria: { label: "Eliminar #{user.email}" },
                        form: { data: { turbo_confirm: "¿Eliminar a #{user.email}? Esta acción no se puede deshacer." } },
                        class: "flex h-12 w-12 cursor-pointer items-center justify-center rounded-2xl text-slate-600 transition-colors hover:bg-red-50 hover:text-red-600" do %>
                    <%= material_icon "delete" %>
                  <% end %>
                <% else %>
                  <span title="No puedes eliminar tu propio usuario" class="flex h-12 w-12 cursor-not-allowed items-center justify-center rounded-2xl text-slate-300">
                    <%= material_icon "delete" %>
                  </span>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
