<%= render "shared/row_actions", label: t("shared.actions.title_named", name: user.email), items: [
  { label: t("shared.actions.show"), icon: "visibility", href: user_path(user) },
  { label: t("shared.actions.edit"), icon: "edit", href: edit_user_path(user) },
  (policy(user).destroy? ? { label: t("shared.actions.destroy"), icon: "delete", href: user_path(user), method: :delete,
                             confirm: t(".confirm_destroy", email: user.email), tone: :danger } : nil)
] %>
