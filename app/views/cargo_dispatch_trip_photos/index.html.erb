<%= turbo_frame_tag "trip_exit_photos_#{@trip.id}" do %>
  <% if @photos.empty? %>
    <p class="text-sm text-slate-500"><%= t("cargo_dispatch.evidence.empty") %></p>
  <% else %>
    <% if policy(@trip).manage_exit_photos? %>
      <%= button_to exit_photos_cargo_dispatch_trip_path(@trip), method: :delete,
            form: { data: { turbo_frame: "_top", turbo_confirm: t("containers.photos.confirm_remove_all") }, class: "mb-3" },
            class: "flex min-h-12 cursor-pointer items-center gap-2 rounded-2xl bg-red-50 px-4 font-medium text-red-700 transition-all duration-200 ease-out hover:bg-red-100 active:scale-95" do %>
        <%= material_icon "delete_sweep" %> <%= t("containers.photos.remove_all") %>
      <% end %>
    <% end %>
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      <% @photos.each do |photo| %>
        <li class="group/photo relative aspect-square overflow-hidden rounded-2xl bg-slate-200 shadow-sm">
          <%= link_to exit_photo_cargo_dispatch_trip_path(@trip, photo_id: photo.id), target: "_blank", rel: "noopener",
                aria: { label: t("containers.photos.open_photo") }, data: { turbo: false }, class: "block h-full w-full" do %>
            <%= image_tag exit_photo_cargo_dispatch_trip_path(@trip, photo_id: photo.id), alt: photo.blob.filename.to_s,
                  loading: "lazy", decoding: "async", class: "h-full w-full object-cover transition-transform duration-200 ease-out group-hover/photo:scale-105" %>
          <% end %>
          <% if policy(@trip).manage_exit_photos? %>
            <%= button_to exit_photo_cargo_dispatch_trip_path(@trip, photo_id: photo.id), method: :delete,
                  form: { data: { turbo_frame: "_top", turbo_confirm: t("cargo_dispatch.evidence.confirm_remove") } },
                  title: t("containers.photos.remove"), aria: { label: t("containers.photos.remove") },
                  class: "absolute right-2 top-2 flex h-12 w-12 cursor-pointer items-center justify-center rounded-full bg-white/90 text-red-600 shadow-sm transition-all duration-200 ease-out hover:bg-red-50 active:scale-95" do %>
              <%= material_icon "delete" %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
