<% if query.length < 3 %>
  <p class="mt-3 text-sm text-slate-500"><%= t("crane.index.search_minimum") %></p>
<% elsif containers.empty? %>
  <p class="mt-3 rounded-xl bg-amber-50 p-3 text-sm text-amber-900"><%= t("crane.index.no_candidates") %></p>
<% else %>
  <ul class="mt-3 divide-y divide-slate-200 rounded-2xl border border-slate-200">
    <% containers.each do |container| %>
      <li class="flex flex-wrap items-center justify-between gap-3 p-3">
        <div>
          <p class="font-semibold text-slate-900"><%= container.number %></p>
          <p class="text-sm text-slate-600"><%= container.current_yard_slot.code %> · <%= t("containers.sizes.#{container.size}") %></p>
        </div>
        <%= link_to new_crane_rehandle_path(container_id: container.id),
              class: "flex min-h-12 items-center gap-2 rounded-full bg-indigo-600 px-5 font-medium text-white transition-all duration-200 ease-out hover:bg-indigo-700 active:scale-95",
              data: { turbo_frame: "_top" } do %>
          <%= material_icon "swap_horiz" %> <%= t("crane.index.select_container") %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
