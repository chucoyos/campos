<% completed_rehandles = request.work_orders.select { |order| order.reacomodo? && order.completada? } %>
<% completed_moves = completed_rehandles.size %>
<% pending_order = pending_orders_by_request[request.id] %>
<% phase = pending_order&.salida? ? "ready" : (pending_order ? "blocked" : "waiting") %>
<article id="<%= dom_id(request) %>" class="rounded-3xl border <%= phase == "ready" ? "border-emerald-200 bg-emerald-50" : "border-amber-200 bg-amber-50" %> p-5 shadow-sm sm:p-6">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="text-sm font-semibold <%= phase == "ready" ? "text-emerald-900" : "text-amber-900" %>"><%= t(".#{phase}") %></p>
      <h3 class="mt-1 text-xl font-bold text-slate-900"><%= request.container.number %></h3>
      <p class="mt-1 text-sm text-slate-700"><%= t(".details", plate: request.movement_pass.vehicle("principal")&.plate, count: completed_moves) %></p>
      <% if pending_order %>
        <p class="mt-2 text-sm font-medium <%= phase == "ready" ? "text-emerald-900" : "text-amber-900" %>">
          <%= pending_order.salida? ? t(".load_pending") : t(".next_task", container: pending_order.container.number) %>
        </p>
      <% else %>
        <p class="mt-2 text-sm font-medium text-amber-900"><%= t(".no_destination") %></p>
      <% end %>
    </div>
    <% if policy(request).cancel? %>
      <%= button_to cancel_crane_rehandling_request_path(request), method: :patch,
            form: { data: { turbo_confirm: t(".confirm_cancel") } },
            class: "flex min-h-12 items-center gap-2 rounded-full border border-amber-300 px-5 font-medium text-amber-900 transition-all duration-200 ease-out hover:bg-amber-100 active:scale-95" do %>
        <%= material_icon "close" %> <%= t(".cancel") %>
      <% end %>
    <% end %>
  </div>
  <% if completed_rehandles.any? %>
    <ol class="mt-4 space-y-2 border-t border-amber-200 pt-4" aria-label="<%= t(".completed_title") %>">
      <% completed_rehandles.each do |work_order| %>
        <li class="flex flex-wrap items-center gap-2 text-sm text-slate-700">
          <%= material_icon "task_alt", classes: "text-emerald-700" %>
          <span class="font-medium"><%= work_order.container.number %></span>
          <span><%= work_order.from_yard_slot.code %> → <%= work_order.to_yard_slot.code %></span>
        </li>
      <% end %>
    </ol>
  <% end %>
  <% if pending_order %>
    <div class="mt-4 border-t <%= phase == "ready" ? "border-emerald-200" : "border-amber-200" %> pt-4">
      <%= render "crane/work_order", work_order: pending_order, destination_options: destination_options %>
    </div>
  <% end %>
</article>
