<%= turbo_stream_from WorkOrder::STREAM %>

<div class="mx-auto w-full max-w-3xl">
  <div class="mb-6 flex items-center gap-3">
    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600"><%= material_icon "precision_manufacturing" %></span>
    <div>
      <h1 class="text-2xl font-bold text-slate-900 sm:text-3xl"><%= t(".title") %></h1>
      <p class="text-sm text-slate-600"><%= t(".description") %></p>
    </div>
  </div>

  <% if @work_orders.empty? %>
    <div class="flex flex-col items-center gap-2 rounded-3xl border border-dashed border-slate-300 bg-white p-10 text-center text-slate-600">
      <span class="text-emerald-600"><%= material_icon "task_alt", classes: "!text-4xl" %></span>
      <p class="text-lg font-semibold text-slate-800"><%= t(".empty") %></p>
      <p class="text-sm"><%= t(".empty_hint") %></p>
    </div>
  <% else %>
    <div class="space-y-4">
      <%= render partial: "crane/work_order", collection: @work_orders, as: :work_order %>
    </div>
  <% end %>
</div>
