<%= render "shared/row_actions", label: t("shared.actions.title_named", name: master_bl.number), items: [
  { label: t("shared.actions.show"), icon: "visibility", href: master_bl_path(master_bl) },
  (policy(master_bl).update? ? { label: t("shared.actions.edit"), icon: "edit", href: edit_master_bl_path(master_bl) } : nil),
  (policy(master_bl).destroy? ? { label: t("shared.actions.destroy"), icon: "delete", href: master_bl_path(master_bl), method: :delete,
    confirm: t("shared.actions.confirm_destroy", name: master_bl.number), tone: :danger } : nil)
] %>
