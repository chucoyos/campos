<%= form_with model: master_bl, class: "space-y-5" do |f| %>
  <% if master_bl.errors.any? %>
    <div class="flex gap-3 rounded-2xl bg-red-50 p-4 text-sm text-red-700" role="alert">
      <%= material_icon "error" %>
      <ul>
        <% master_bl.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :number, class: "mb-1 block text-sm font-medium text-slate-700" %>
    <%= f.text_field :number, autofocus: true, class: "w-full rounded-2xl border border-slate-200 bg-white p-3 uppercase focus:border-indigo-500 focus:outline-none" %>
  </div>

  <div>
    <%= f.label :client_id, class: "mb-1 block text-sm font-medium text-slate-700" %>
    <%= f.collection_select :client_id, Client.order(:name), :id, :name, { prompt: t(".client_prompt") }, class: "w-full rounded-2xl border border-slate-200 bg-white p-3 focus:border-indigo-500 focus:outline-none" %>
  </div>

  <div class="flex flex-wrap items-center gap-3 pt-2">
    <%= f.button class: "flex min-h-12 cursor-pointer items-center gap-2 rounded-2xl bg-indigo-600 px-5 font-medium text-white transition-colors hover:bg-indigo-700" do %>
      <%= material_icon "save" %> <%= master_bl.persisted? ? t("shared.actions.save") : t("shared.actions.create") %>
    <% end %>
    <%= link_to master_bls_path, class: "flex min-h-12 items-center gap-2 rounded-2xl px-5 font-medium text-slate-600 transition-colors hover:bg-slate-100" do %>
      <%= material_icon "close" %> <%= t("shared.actions.cancel") %>
    <% end %>
  </div>
<% end %>
