<div class="mx-auto w-full max-w-4xl">
  <%= link_to master_bls_path, class: "mb-4 inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-800" do %>
    <%= material_icon "arrow_back" %> <%= t("shared.actions.back") %>
  <% end %>

  <div class="rounded-3xl border border-slate-100 bg-white p-8 shadow-sm">
    <div class="mb-6 flex items-center gap-4">
      <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600">
        <%= material_icon "description", classes: "!text-3xl" %>
      </span>
      <h1 class="text-2xl font-bold text-slate-900"><%= @master_bl.number %></h1>
    </div>

    <dl class="grid gap-4 rounded-2xl bg-slate-50 p-4 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-slate-500"><%= MasterBl.human_attribute_name(:client) %></dt>
        <dd class="font-medium text-slate-800"><%= link_to @master_bl.client.name, client_path(@master_bl.client), class: "text-indigo-600 hover:underline" %></dd>
      </div>
      <div>
        <dt class="text-slate-500"><%= MasterBl.human_attribute_name(:created_at) %></dt>
        <dd class="font-medium text-slate-800"><%= l(@master_bl.created_at, format: :long) %></dd>
      </div>
      <div>
        <dt class="text-slate-500"><%= MasterBl.human_attribute_name(:updated_at) %></dt>
        <dd class="font-medium text-slate-800"><%= l(@master_bl.updated_at, format: :long) %></dd>
      </div>
    </dl>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <%= link_to edit_master_bl_path(@master_bl), class: "flex min-h-12 items-center gap-2 rounded-2xl bg-indigo-600 px-5 font-medium text-white transition-colors hover:bg-indigo-700" do %>
        <%= material_icon "edit" %> <%= t("shared.actions.edit") %>
      <% end %>
      <%= button_to master_bl_path(@master_bl), method: :delete,
            form: { data: { turbo_confirm: t("shared.actions.confirm_destroy", name: @master_bl.number) } },
            class: "flex min-h-12 cursor-pointer items-center gap-2 rounded-2xl px-5 font-medium text-red-600 transition-colors hover:bg-red-50" do %>
        <%= material_icon "delete" %> <%= t("shared.actions.destroy") %>
      <% end %>
    </div>
  </div>

  <section class="mt-6 rounded-3xl border border-slate-100 bg-white p-8 shadow-sm">
    <h2 class="mb-3 flex items-center gap-3 text-lg font-bold text-slate-900">
      <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600">
        <%= material_icon "picture_as_pdf" %>
      </span>
      <%= t(".document_title") %>
    </h2>

    <% if @document_errors.present? %>
      <div class="mb-4 flex gap-3 rounded-2xl bg-red-50 p-4 text-sm text-red-700" role="alert">
        <%= material_icon "error" %>
        <ul><% @document_errors.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>

    <% if @master_bl.document.attached? %>
      <div class="mb-4 flex flex-col gap-3 rounded-2xl bg-slate-50 p-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="min-w-0">
          <p class="truncate font-medium text-slate-800"><%= @master_bl.document.filename %></p>
          <p class="text-sm text-slate-500"><%= number_to_human_size(@master_bl.document.byte_size) %></p>
        </div>
        <div class="flex flex-wrap gap-2">
          <%= link_to document_master_bl_path(@master_bl), target: "_blank", rel: "noopener", class: "flex min-h-12 items-center gap-2 rounded-2xl bg-slate-100 px-5 font-medium text-slate-700 transition-all duration-200 ease-out hover:bg-slate-200 active:scale-95" do %>
            <%= material_icon "open_in_new" %> <%= t(".document_open") %>
          <% end %>
          <%= button_to remove_document_master_bl_path(@master_bl), method: :delete,
                form: { data: { turbo_confirm: t(".document_confirm_remove") } },
                class: "flex min-h-12 cursor-pointer items-center gap-2 rounded-2xl px-5 font-medium text-red-600 transition-colors hover:bg-red-50" do %>
            <%= material_icon "delete" %> <%= t(".document_remove") %>
          <% end %>
        </div>
      </div>
    <% else %>
      <p class="mb-4 text-sm text-slate-500"><%= t(".no_document") %> <%= t(".document_hint") %></p>
    <% end %>

    <%= form_with url: upload_document_master_bl_path(@master_bl), method: :patch, multipart: true,
          data: { controller: "direct-upload", direct_upload_max_size_value: MasterBl::DOCUMENT_MAX_SIZE,
                  direct_upload_too_large_value: t(".document_too_large"), direct_upload_failed_value: t(".document_upload_failed") },
          class: "flex flex-wrap items-center gap-3 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-4" do |f| %>
      <%= f.label :document, t(".document_label"), class: "sr-only" %>
      <%= f.file_field :document, accept: "application/pdf", required: true, direct_upload: true,
            data: { direct_upload_target: "input", action: "change->direct-upload#validate" },
            class: "min-h-12 w-full flex-1 text-sm text-slate-600 file:mr-3 file:min-h-12 file:cursor-pointer file:rounded-2xl file:border-0 file:bg-indigo-50 file:px-4 file:font-medium file:text-indigo-700 hover:file:bg-indigo-100 sm:w-auto" %>
      <%= f.button data: { direct_upload_target: "submit" }, class: "flex min-h-12 cursor-pointer items-center justify-center gap-2 rounded-2xl bg-indigo-600 px-5 font-medium text-white transition-all duration-200 ease-out hover:bg-indigo-700 active:scale-95" do %>
        <%= material_icon "upload_file" %> <%= @master_bl.document.attached? ? t(".document_replace") : t(".document_upload") %>
      <% end %>
      <div class="hidden w-full" data-direct-upload-target="progress" role="progressbar" aria-label="<%= t(".document_uploading") %>">
        <div class="h-2 overflow-hidden rounded-full bg-slate-200">
          <div class="h-full w-0 rounded-full bg-indigo-600 transition-all duration-200 ease-out" data-direct-upload-target="bar"></div>
        </div>
      </div>
      <p class="hidden w-full text-sm text-red-700" role="alert" data-direct-upload-target="error"></p>
    <% end %>
  </section>

  <section class="mt-6 rounded-3xl border border-slate-100 bg-white p-8 shadow-sm">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
      <h2 class="flex items-center gap-3 text-lg font-bold text-slate-900">
        <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600">
          <%= material_icon "inventory_2" %>
        </span>
        <span><%= Container.model_name.human(count: 2) %> <span class="text-sm font-normal text-slate-500">(<%= @containers.size %>)</span></span>
      </h2>
      <div class="flex flex-wrap gap-2">
      <%= link_to new_container_path(container: { master_bl_id: @master_bl.id }), class: "flex min-h-12 items-center gap-2 rounded-2xl bg-indigo-600 px-5 font-medium text-white transition-all duration-200 ease-out hover:bg-indigo-700 active:scale-95" do %>
        <%= material_icon "add" %> <%= t(".new_container") %>
      <% end %>
      <%= link_to template_master_bl_path(@master_bl), class: "flex min-h-12 items-center gap-2 rounded-2xl bg-slate-100 px-5 font-medium text-slate-700 transition-all duration-200 ease-out hover:bg-slate-200 active:scale-95" do %>
        <%= material_icon "download" %> <%= t(".download_template") %>
      <% end %>
      </div>
    </div>

    <%= form_with url: import_master_bl_path(@master_bl), multipart: true, class: "mb-4 flex flex-col gap-3 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-4 sm:flex-row sm:items-center" do |f| %>
      <%= f.label :file, t(".upload_label"), class: "sr-only" %>
      <%= f.file_field :file, accept: ".xlsx", required: true,
            class: "min-h-12 w-full flex-1 text-sm text-slate-600 file:mr-3 file:min-h-12 file:cursor-pointer file:rounded-2xl file:border-0 file:bg-indigo-50 file:px-4 file:font-medium file:text-indigo-700 hover:file:bg-indigo-100" %>
      <%= f.button class: "flex min-h-12 cursor-pointer items-center justify-center gap-2 rounded-2xl bg-indigo-600 px-5 font-medium text-white transition-all duration-200 ease-out hover:bg-indigo-700 active:scale-95" do %>
        <%= material_icon "upload_file" %> <%= t(".upload") %>
      <% end %>
    <% end %>

    <% if @import_errors.present? %>
      <div class="mb-4 flex gap-3 rounded-2xl bg-red-50 p-4 text-sm text-red-700" role="alert">
        <%= material_icon "error" %>
        <div>
          <p class="font-medium"><%= t(".import_failed") %></p>
          <ul class="mt-1 list-disc pl-5">
            <% @import_errors.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <% if @containers.empty? %>
      <p class="rounded-2xl bg-slate-50 p-4 text-sm text-slate-500"><%= t(".no_containers") %></p>
    <% else %>
      <ul class="space-y-3 md:hidden">
        <% @containers.each do |container| %>
          <li class="flex items-center justify-between gap-2 rounded-2xl border border-slate-100 p-3">
            <div class="min-w-0">
              <%= link_to container.number, container_path(container), class: "block truncate font-medium text-indigo-600 hover:underline" %>
              <p class="text-xs text-slate-500"><%= t("containers.sizes.#{container.size}") %> · <%= t("containers.types.#{container.container_type}") %></p>
            </div>
            <%= render "containers/status", container: container %>
          </li>
        <% end %>
      </ul>

      <div class="hidden overflow-hidden rounded-2xl border border-slate-100 md:block">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
            <tr>
              <th class="p-3"><%= Container.human_attribute_name(:number) %></th>
              <th class="p-3"><%= Container.human_attribute_name(:size) %></th>
              <th class="p-3"><%= Container.human_attribute_name(:container_type) %></th>
              <th class="p-3"><%= Container.human_attribute_name(:status) %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @containers.each do |container| %>
              <tr class="transition-colors hover:bg-slate-50">
                <td class="p-3 font-medium"><%= link_to container.number, container_path(container), class: "text-indigo-600 hover:underline" %></td>
                <td class="p-3 text-slate-600"><%= t("containers.sizes.#{container.size}") %></td>
                <td class="p-3 text-slate-600"><%= t("containers.types.#{container.container_type}") %></td>
                <td class="p-3"><%= render "containers/status", container: container %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
</div>
