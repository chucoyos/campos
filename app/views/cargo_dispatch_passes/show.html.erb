<div class="mx-auto max-w-3xl space-y-5">
  <%= link_to t("shared.actions.back"), cargo_dispatch_trip_path(@pass.cargo_dispatch_trip), class: "text-indigo-700" %>
  <section class="space-y-4 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
    <h1 class="text-3xl font-bold"><%= t("cargo_dispatch.ui.pass_number", number: @pass.id) %></h1>
    <p><%= @pass.operator_name %> · <%= @pass.plate %></p>
    <% if @gate_url %>
      <div class="flex flex-col items-center gap-3 rounded-2xl bg-slate-50 p-5">
        <%= image_tag "data:image/svg+xml;base64,#{Base64.strict_encode64(RQRCode::QRCode.new(@gate_url, level: :m).as_svg(module_size: 4, viewbox: true, use_path: true))}", alt: t("movement_passes.show.qr_alt"), class: "h-56 w-56" %>
        <span class="break-all font-mono text-sm"><%= @pass.token %></span>
        <%= link_to t("movement_passes.show.download"), cargo_dispatch_pass_path(@pass, format: :pdf), target: "_blank", rel: "noopener", class: "flex min-h-12 items-center rounded-full bg-indigo-600 px-5 text-white" %>
      </div>
      <% if policy(@pass).cancel? %>
        <%= button_to t("movement_passes.show.cancel"), cancel_cargo_dispatch_pass_path(@pass), method: :patch, class: "min-h-12 rounded-full px-5 text-red-700 hover:bg-red-50" %>
      <% end %>
    <% end %>
  </section>
</div>
