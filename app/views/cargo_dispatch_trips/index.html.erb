<div class="mx-auto max-w-5xl space-y-5">
  <h1 class="text-3xl font-bold"><%= t("cargo_dispatch.ui.trips") %></h1>
  <ul class="space-y-3">
    <% @trips.each do |trip| %>
      <li class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
        <%= link_to t("cargo_dispatch.ui.trip_number", number: trip.id), cargo_dispatch_trip_path(trip), class: "font-semibold text-indigo-700" %>
        <p class="text-sm text-slate-600"><%= t("cargo_dispatch.ui.trip_statuses.#{trip.status}") %> · <%= trip.carrier&.name || trip.transport_name %></p>
        <% if current_user.admin? || current_user.client_member? %><p class="text-sm text-slate-600"><%= trip.cargo_dispatch_request.client.name %></p><% end %>
      </li>
    <% end %>
  </ul>
  <%= render "shared/pagination", pagy: @pagy %>
</div>
